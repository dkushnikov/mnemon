# Mnemon instance configuration — generated by `mnemon init`
# Flat YAML only (no nesting). Paths may start with ~.
# Lives at $MNEMON_CONFIG_DIR/instances/<instance>.yaml
# (MNEMON_CONFIG_DIR defaults to ${XDG_CONFIG_HOME:-~/.config}/mnemon).
# Values `mnemon init` writes are double-quoted (`"` and `\` escaped as \" and \\)
# so a space or a ` #` in a path survives; an unquoted value ends at ` #`.

# Instance name — matches the file name. Select with `mnemon --instance <name>`
# or MNEMON_INSTANCE=<name>; `mnemon init --default` makes it the default.
instance: "{{instance}}"

vault_path: "{{vault_path}}"
reader_context_path: "{{vault_path}}/reader-context.md"

# Search backend declared for this vault: grep (zero deps) or qmd (hybrid BM25 +
# vector index for the qmd CLI, needs qmd installed). `mnemon search` always runs
# its grep-style scan and reports both values (provider: grep, configured_provider:
# this). With qmd, `mnemon add` refreshes the qmd index after a capture and
# `mnemon doctor` requires qmd.
search_provider: grep
# qmd collection name — one collection per vault. Convention: obsidian-<vault-purpose>
# (matches the pattern used for other Obsidian-vault collections). Change it with
# `mnemon init ... --collection <name>` or by editing this file; the qmd setup
# reads it from here, not from the template.
qmd_collection: obsidian-knowledge

# Extraction
default_model: sonnet
default_language: en

# Media (optional deps: yt-dlp, whisper, ffprobe)
whisper_model: large-v3
auto_detect_origin: true

# Source archival: save original files (PDF, audio, page snapshots) before
# extraction. Enables re-extraction when models improve, without re-fetching
# from URLs that may go offline. Set to any directory path. Omit to disable.
# archive_dir: ~/mnemon-archive

# Per-instance runtime state (locks, caches, logs). Optional.
# Default: ${XDG_STATE_HOME:-~/.local/state}/mnemon/{{instance}}
# state_dir: ~/.local/state/mnemon/{{instance}}

# Vault charter — what this vault is for. Optional; `mnemon doctor` warns when missing.
# Default: <vault_path>/_meta/charter.md
# charter_path: {{vault_path}}/_meta/charter.md

# Writer host — when set, only this host (hostname -s) may write the vault;
# `mnemon doctor` fails on any other host. Optional.
# writer_host: my-laptop
