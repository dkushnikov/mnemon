#!/usr/bin/env bash
# mnemon — command dispatcher for the Mnemon engine.
#
#   mnemon [--instance <name>] [--config <path>] <command> [args…]
#
# MNEMON_ROOT is this script's own repo root (symlinks resolved), so a symlink
# such as ~/.local/bin/mnemon → $MNEMON_HOME/bin/mnemon works. Subcommands that
# need configuration call load_config (bin/mnemon-config.sh) and fail with its
# message. bash 3.2 compatible: no associative arrays, no ${var,,}, no mapfile.
set -euo pipefail

# --- Locate the engine root: resolve symlinks of $0 without readlink -f ---
_self="${BASH_SOURCE[0]:-$0}"
while [[ -L "$_self" ]]; do
  _target="$(readlink "$_self")"
  case "$_target" in
    /*) _self="$_target" ;;
    *)  _self="$(dirname "$_self")/$_target" ;;
  esac
done
MNEMON_ROOT="$(cd "$(dirname "$_self")/.." && pwd -P)"
export MNEMON_ROOT
BIN_DIR="$MNEMON_ROOT/bin"
# shellcheck source=mnemon-config.sh
source "$BIN_DIR/mnemon-config.sh"

usage() {
  cat <<'USAGE'
Usage: mnemon [--instance <name>] [--config <path>] <command> [args...]

Commands:
  add <gateway options>      Capture a source (knowledge-gateway.sh source-add)
  status                     Pipeline status for the instance
  search --query <q> [...]   Search extracts (JSON; --human for text)
  reindex                    Rebuild the vault's index.md
  triage <input> [...]       Content-aware URL triage against the vault
  audit [--cutoff DATE]      Archive consistency audit
  init <name> --vault <path> [--archive <dir>] [--collection <name>]
       [--reader-context <path>] [--charter <path>] [--writer-host <host>]
       [--default] [--force] [--non-interactive]
                             Create an instance config and scaffold its vault
  doctor [--instance <name>] [--json]
                             Health checks: ok|warn|fail <check> — <detail>
  config get <key> | path | list | dump
                             Resolved configuration
  release [--dry-run] [--now] [--drain-timeout <s>] [--rollback <ref>]
                             Maintainer: promote main → release → installed engine
                             (lock → drain → ff-merge → smoke → push); --rollback resets
                             the engine to <ref> under the same lock
  version                    Engine version, branch, commit and root
  help                       This text
  ingest | scan | monitor    Reserved (program phase 4)

Global options (one of them; both on one command line → exit 2):
  --instance <name>          Select an instance   (exports MNEMON_INSTANCE, drops an inherited MNEMON_CONFIG)
  --config <path>            Explicit config file (exports MNEMON_CONFIG, drops an inherited MNEMON_INSTANCE)

Config resolution — explicit beats inherited: --config → --instance → $MNEMON_CONFIG →
$MNEMON_INSTANCE → ./mnemon.yaml → $MNEMON_CONFIG_DIR/default → legacy mnemon.yaml (warns).
$MNEMON_CONFIG and $MNEMON_INSTANCE both set must agree (same file, or the file declares
that instance), otherwise exit 2. The dispatcher resolves once and exports the pair to the
command. MNEMON_CONFIG_DIR defaults to ${XDG_CONFIG_HOME:-~/.config}/mnemon; instances live
in its instances/ folder.
USAGE
}

die() { printf 'mnemon: %s\n' "$*" >&2; exit 1; }
usage_error() { printf 'mnemon: %s\n\n' "$*" >&2; usage >&2; exit 2; }

# Physical path of an existing directory.
_abs_dir() { (cd "$1" 2>/dev/null && pwd -P); }

_expand_tilde() { _mnemon_expand_tilde "$1"; }

# Tilde-free absolute path; the parent must exist, the leaf need not.
_abs_path() {
  local p d
  p="$(_expand_tilde "$1")"
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  d="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || { printf '%s' "$p"; return 0; }
  if [[ "$d" == "/" ]]; then printf '/%s' "$(basename "$p")"; else printf '%s/%s' "$d" "$(basename "$p")"; fi
}

# Escape a replacement string for `sed s|...|...|`.
_sed_esc() { printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'; }

# Short host name (hostname -s, falling back to the first label of hostname).
_host() {
  local h
  h="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo unknown)"
  printf '%s' "${h%%.*}"
}

# --- Instance selection (A1): a flag outranks the inherited environment ---
CLI_CONFIG=""
CLI_INSTANCE=""
_select_config()   { CLI_CONFIG="$(_abs_path "$1")"; }
_select_instance() { CLI_INSTANCE="$1"; }
# Export the flag's selector and drop the other inherited one; refuse both flags.
_apply_selectors() {
  if [[ -n "$CLI_CONFIG" && -n "$CLI_INSTANCE" ]]; then
    usage_error "conflicting selectors: --config and --instance on one command line (use one)"
  fi
  if [[ -n "$CLI_CONFIG" ]]; then
    export MNEMON_CONFIG="$CLI_CONFIG" MNEMON_SELECTED_BY="--config"
    unset MNEMON_INSTANCE MNEMON_CONFIG_SOURCE
  elif [[ -n "$CLI_INSTANCE" ]]; then
    export MNEMON_INSTANCE="$CLI_INSTANCE" MNEMON_SELECTED_BY="--instance"
    unset MNEMON_CONFIG MNEMON_CONFIG_SOURCE
  fi
}
# Resolve once; the exported MNEMON_CONFIG + MNEMON_INSTANCE pair is what children see.
_resolve_or_die() { load_config || exit $?; }
# Selectors are global options; a child must never re-decide (`mnemon add --instance x` is refused).
_reject_post_command_selectors() {
  local a
  for a in "$@"; do
    case "$a" in
      --config|--config=*|--instance|--instance=*)
        usage_error "$a belongs before the command: mnemon $a <command> …" ;;
    esac
  done
}
_has_flag() {
  local want="$1" a; shift
  for a in "$@"; do
    case "$a" in "$want"|"$want"=*) return 0 ;; esac
  done
  return 1
}

# JSON string body (no surrounding quotes).
_json_str() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\t' '  '; }

# Absolute physical path of a worktree's common git dir (same repo ⇔ same value).
_git_common_dir() {
  local d
  d="$(git -C "$1" rev-parse --git-common-dir 2>/dev/null)" || return 1
  case "$d" in /*) ;; *) d="$1/$d" ;; esac
  (cd "$d" 2>/dev/null && pwd -P)
}

# Path without trailing slashes ("/" stays "/").
_strip_trailing_slashes() {
  local p="$1"
  while [[ "$p" == */ && "$p" != / ]]; do p="${p%/}"; done
  printf '%s' "$p"
}

# Escape every ERE metacharacter so a path can be used literally in pgrep -f.
_re_escape() { printf '%s' "$1" | sed -e 's/[]\\.^$*+?(){}|[]/\\&/g'; }

# pgrep -f pattern for engine processes under <home>/bin/ in both spellings of
# the engine path: the physical one ($1) and the one MNEMON_HOME was given as
# ($2) — a process started through a symlinked MNEMON_HOME carries the symlink
# spelling on its command line.
_drain_pattern() {
  local phys="$1" given="$2"
  if [[ "$phys" == "$given" ]]; then
    printf '%s/bin/' "$(_re_escape "$phys")"
  else
    printf '(%s|%s)/bin/' "$(_re_escape "$phys")" "$(_re_escape "$given")"
  fi
}

# Closest existing ancestor of a path (the path itself if it exists).
_nearest_existing_parent() {
  local p="$1"
  while [[ -n "$p" && "$p" != "/" && ! -e "$p" ]]; do p="$(dirname "$p")"; done
  if [[ -e "$p" ]]; then printf '%s' "$p"; fi
}

# Copy src → dst unless dst exists (never overwrite vault files).
_copy_if_missing() {
  local src="$1" dst="$2" label="$3"
  if [[ -f "$dst" ]]; then
    echo "  ○ skipped $label (exists)"
  elif [[ ! -f "$src" ]]; then
    echo "  ○ skipped $label (no template at $src)"
  else
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    echo "  ✓ created $label"
  fi
}

# YAML double-quoted scalar: `\` and `"` escaped (the loader decodes exactly
# these two), wrapped in quotes — a space or a ` #` in a path survives.
_yaml_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
_yaml_dq()  { printf '"%s"' "$(_yaml_esc "$1")"; }

# Set `key: value` in a flat yaml file: replace an existing line, uncomment a
# `# key:` template line, or append. The value is written double-quoted unless
# $4 is `raw` (enum-like values such as search_provider stay bare and greppable).
_yaml_set() {
  local file="$1" key="$2" value="$3" mode="${4:-}" tmp rendered
  if [[ "$mode" == raw ]]; then rendered="$value"; else rendered="$(_yaml_dq "$value")"; fi
  tmp="$(mktemp "$file.XXXXXX")"
  if grep -q "^$key:" "$file" 2>/dev/null; then
    sed -e "s|^$key:.*|$key: $(_sed_esc "$rendered")|" "$file" > "$tmp"
  elif grep -q "^# $key:" "$file" 2>/dev/null; then
    sed -e "s|^# $key:.*|$key: $(_sed_esc "$rendered")|" "$file" > "$tmp"
  else
    cat "$file" > "$tmp"
    printf '%s: %s\n' "$key" "$rendered" >> "$tmp"
  fi
  mv "$tmp" "$file"
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
  local name="" vault="" archive="" collection="" reader_src="" charter="" writer_host=""
  local set_default=false force=false non_interactive=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)           [[ $# -lt 2 ]] && usage_error "init: --vault requires a path"; vault="$2"; shift 2 ;;
      --archive)         [[ $# -lt 2 ]] && usage_error "init: --archive requires a dir"; archive="$2"; shift 2 ;;
      --collection)      [[ $# -lt 2 ]] && usage_error "init: --collection requires a name"; collection="$2"; shift 2 ;;
      --reader-context)  [[ $# -lt 2 ]] && usage_error "init: --reader-context requires a path"; reader_src="$2"; shift 2 ;;
      --charter)         [[ $# -lt 2 ]] && usage_error "init: --charter requires a path"; charter="$2"; shift 2 ;;
      --writer-host)     [[ $# -lt 2 ]] && usage_error "init: --writer-host requires a host"; writer_host="$2"; shift 2 ;;
      --default)         set_default=true; shift ;;
      --force)           force=true; shift ;;
      --non-interactive) non_interactive=true; shift ;;
      -h|--help)         usage; exit 0 ;;
      -*)                usage_error "init: unknown option $1" ;;
      *)
        [[ -z "$name" ]] || usage_error "init: unexpected argument '$1'"
        name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || usage_error "init: instance name required"
  local name_re='^[A-Za-z0-9][A-Za-z0-9._-]*$'
  [[ "$name" =~ $name_re ]] || die "init: invalid instance name '$name' (letters, digits, . _ - ; must start with a letter or digit)"
  [[ "$name" != "$MNEMON_ADHOC_INSTANCE" ]] || die "init: '$MNEMON_ADHOC_INSTANCE' is reserved for configs loaded by path"

  if [[ -z "$vault" ]]; then
    if ! $non_interactive && [[ -t 0 ]]; then
      printf 'Vault path for instance %s: ' "$name" >&2
      IFS= read -r vault || vault=""
    fi
    [[ -n "$vault" ]] || usage_error "init: --vault <path> required"
  fi

  local cfg_dir inst_dir inst_file template
  cfg_dir="$(mnemon_config_dir)"
  inst_dir="$cfg_dir/instances"
  inst_file="$inst_dir/$name.yaml"
  template="$MNEMON_ROOT/mnemon.yaml.template"
  [[ -f "$template" ]] || die "init: template not found: $template"
  if [[ -f "$inst_file" ]] && ! $force; then
    die "init: instance '$name' already exists at $inst_file (use --force to overwrite the config; vault files are never overwritten)"
  fi

  # Vault: create and make tilde-free absolute.
  vault="$(_expand_tilde "$vault")"
  mkdir -p "$vault" || die "init: cannot create vault directory $vault"
  vault="$(_abs_dir "$vault")"

  echo "=== mnemon init: $name ==="
  echo "Vault:  $vault"
  echo "Config: $inst_file"
  echo ""

  # 1. Vault scaffold (like setup.sh steps 1–2; never overwrites)
  echo "1. Vault scaffold"
  mkdir -p "$vault/Sources" "$vault/Synthesis" "$vault/_meta"
  echo "  ✓ Sources/ Synthesis/ _meta/"
  _copy_if_missing "$MNEMON_ROOT/vault-template/CLAUDE.md" "$vault/CLAUDE.md" "CLAUDE.md"
  _copy_if_missing "$MNEMON_ROOT/vault-template/_meta/Protocol.md" "$vault/_meta/Protocol.md" "_meta/Protocol.md"
  if [[ -n "$reader_src" ]]; then
    reader_src="$(_expand_tilde "$reader_src")"
    [[ -f "$reader_src" ]] || die "init: reader context not found: $reader_src"
    _copy_if_missing "$reader_src" "$vault/reader-context.md" "reader-context.md (from $reader_src)"
  else
    _copy_if_missing "$MNEMON_ROOT/reader-context.md.template" "$vault/reader-context.md" "reader-context.md (generic — edit to personalize)"
  fi
  _copy_if_missing "$MNEMON_ROOT/mnemon-seed.md" "$vault/mnemon-seed.md" "mnemon-seed.md (reader profile builder)"

  # 2. Instance config from the template
  echo "2. Instance config"
  mkdir -p "$inst_dir"
  local tmp
  tmp="$(mktemp "$inst_dir/.$name.XXXXXX")"
  # The template holds the placeholders inside double quotes: YAML-escape, then sed-escape.
  sed -e "s|{{instance}}|$(_sed_esc "$(_yaml_esc "$name")")|g" \
      -e "s|{{vault_path}}|$(_sed_esc "$(_yaml_esc "$vault")")|g" \
      "$template" > "$tmp"
  if [[ -n "$collection" ]];  then _yaml_set "$tmp" qmd_collection "$collection"; fi
  if [[ -n "$archive" ]]; then
    archive="$(_abs_path "$archive")"
    if [[ -d "$archive" ]]; then
      echo "  ○ archive dir exists: $archive"
    elif mkdir -p "$archive" 2>/dev/null; then
      echo "  ✓ created archive dir $archive"
    else
      rm -f "$tmp"
      die "init: cannot create archive dir $archive (choose a writable --archive path)"
    fi
    _yaml_set "$tmp" archive_dir "$archive"
  fi
  if [[ -n "$charter" ]];     then _yaml_set "$tmp" charter_path "$(_abs_path "$charter")"; fi
  if [[ -n "$writer_host" ]]; then _yaml_set "$tmp" writer_host "$writer_host"; fi
  mv "$tmp" "$inst_file"
  if $force; then echo "  ✓ wrote $inst_file (overwritten)"; else echo "  ✓ wrote $inst_file"; fi

  # 3. Default instance
  echo "3. Default instance"
  local def_file="$cfg_dir/default" prev="" stale=""
  prev="$(_mnemon_default_instance "$def_file" 2>/dev/null || true)"
  if [[ -n "$prev" && "$prev" != "$name" && ! -f "$inst_dir/$prev.yaml" ]]; then
    stale="$prev"; prev=""
  fi
  if $set_default || [[ -z "$prev" ]]; then
    printf '%s\n' "$name" > "$def_file"
    if [[ -n "$stale" ]]; then
      echo "  ✓ default instance → $name ($def_file; it named '$stale', which has no config at $inst_dir/$stale.yaml)"
    else
      echo "  ✓ default instance → $name ($def_file)"
    fi
    prev="$name"
  else
    echo "  ○ default instance unchanged: $prev (use --default to switch)"
  fi

  echo ""
  echo "Next: mnemon doctor"
  if [[ "$prev" != "$name" ]]; then
    echo "      (this instance is not the default — select it with: mnemon --instance $name doctor)"
  fi
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

DOCTOR_JSON=false
DOCTOR_FAILS=0
DOCTOR_ITEMS=""

_check() {
  local status="$1" name="$2" detail="$3"
  if [[ "$status" == fail ]]; then DOCTOR_FAILS=$((DOCTOR_FAILS + 1)); fi
  if $DOCTOR_JSON; then
    if [[ -n "$DOCTOR_ITEMS" ]]; then DOCTOR_ITEMS="$DOCTOR_ITEMS,"; fi
    DOCTOR_ITEMS="$DOCTOR_ITEMS{\"name\":\"$(_json_str "$name")\",\"status\":\"$status\",\"detail\":\"$(_json_str "$detail")\"}"
  else
    printf '%s %s — %s\n' "$status" "$name" "$detail"
  fi
}

cmd_doctor() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --instance) [[ $# -lt 2 ]] && usage_error "doctor: --instance requires a value"; _select_instance "$2"; _apply_selectors; shift 2 ;;
      --json)     DOCTOR_JSON=true; shift ;;
      -h|--help)  usage; exit 0 ;;
      *)          usage_error "doctor: unknown option $1" ;;
    esac
  done

  local have_config=false errf warn
  errf="$(mktemp)"
  if load_config 2>"$errf"; then
    have_config=true
    warn="$(tr '\n' ' ' <"$errf" | sed 's/[[:space:]]*$//')"
    if [[ -n "$warn" ]]; then
      _check warn config "$MNEMON_CONFIG_FILE (instance $MNEMON_INSTANCE; selected by $MNEMON_CONFIG_SOURCE); $warn"
    else
      _check ok config "$MNEMON_CONFIG_FILE (instance $MNEMON_INSTANCE; selected by $MNEMON_CONFIG_SOURCE)"
    fi
  else
    _check fail config "$(tr '\n' ' ' <"$errf" | sed 's/[[:space:]]*$//')"
  fi
  rm -f "$errf"

  if $have_config; then
    # vault
    local missing=""
    if [[ ! -d "$VAULT_PATH" ]]; then
      missing="vault directory"
    else
      [[ -d "$VAULT_PATH/Sources" ]] || missing="Sources/"
      if [[ ! -d "$VAULT_PATH/_meta" ]]; then missing="${missing:+$missing, }_meta/"; fi
    fi
    if [[ -z "$missing" ]]; then
      _check ok vault "$VAULT_PATH"
    elif [[ "$MNEMON_INSTANCE" == "$MNEMON_ADHOC_INSTANCE" ]]; then
      _check fail vault "$VAULT_PATH (missing: $missing) — fix vault_path in $MNEMON_CONFIG_FILE"
    else
      _check fail vault "$VAULT_PATH (missing: $missing) — run: mnemon init $MNEMON_INSTANCE --vault $VAULT_PATH --force"
    fi

    # reader-context
    if [[ -f "$READER_CONTEXT_PATH" ]]; then
      _check ok reader-context "$READER_CONTEXT_PATH"
    else
      _check fail reader-context "not found: $READER_CONTEXT_PATH"
    fi

    # charter
    if [[ -f "$CHARTER_PATH" ]]; then
      _check ok charter "$CHARTER_PATH"
    else
      _check warn charter "missing $CHARTER_PATH (optional)"
    fi

    # archive
    if [[ -z "$ARCHIVE_DIR" ]]; then
      _check ok archive "archive_dir not set (skipped)"
    elif [[ ! -d "$ARCHIVE_DIR" ]]; then
      _check fail archive "not a directory: $ARCHIVE_DIR"
    elif [[ ! -w "$ARCHIVE_DIR" ]]; then
      _check fail archive "not writable: $ARCHIVE_DIR"
    else
      _check ok archive "$ARCHIVE_DIR (writable)"
    fi

    # state — observational: report whether the dir exists or could be created,
    # never create it (doctor writes nothing)
    if [[ -d "$MNEMON_STATE_DIR" ]]; then
      if [[ -w "$MNEMON_STATE_DIR" ]]; then
        _check ok state "$MNEMON_STATE_DIR"
      else
        _check fail state "$MNEMON_STATE_DIR is not writable"
      fi
    else
      local parent
      parent="$(_nearest_existing_parent "$MNEMON_STATE_DIR")"
      if [[ -n "$parent" && -w "$parent" ]]; then
        _check ok state "$MNEMON_STATE_DIR (absent, parent writable)"
      else
        _check fail state "cannot create $MNEMON_STATE_DIR (nearest existing parent ${parent:-/} is not writable)"
      fi
    fi
  fi

  # deps — required
  local required="claude jq shasum python3" optional="defuddle pandoc yt-dlp ffprobe whisper"
  local dep missing_req="" missing_opt=""
  for dep in $required; do
    command -v "$dep" >/dev/null 2>&1 || missing_req="${missing_req:+$missing_req }$dep"
  done
  if [[ -z "$missing_req" ]]; then
    _check ok deps "required present: $required"
  else
    _check fail deps "missing required: $missing_req"
  fi
  for dep in $optional; do
    command -v "$dep" >/dev/null 2>&1 || missing_opt="${missing_opt:+$missing_opt }$dep"
  done
  if [[ -z "$missing_opt" ]]; then
    _check ok deps-optional "all present: $optional"
  else
    _check warn deps-optional "missing: $missing_opt"
  fi
  # python packages used by depth-aware capture (kb-depth-fold.py, kb_fetch.py):
  # without them `--depth auto` degrades to a plain capture
  local missing_py=""
  python3 -c 'import yaml' >/dev/null 2>&1 || missing_py="pyyaml"
  python3 -c 'import requests' >/dev/null 2>&1 || missing_py="${missing_py:+$missing_py }requests"
  if [[ -z "$missing_py" ]]; then
    _check ok deps-python "pyyaml requests"
  else
    _check warn deps-python "missing: $missing_py (depth-aware capture degrades; pip3 install $missing_py)"
  fi

  # qmd — required only when search_provider is qmd
  if $have_config && [[ "$SEARCH_PROVIDER" == qmd ]]; then
    if ! command -v qmd >/dev/null 2>&1; then
      _check fail qmd "search_provider is qmd but qmd is not installed"
    else
      _check ok qmd "$(command -v qmd)"
      # `qmd collection list` creates ${XDG_CACHE_HOME:-~/.cache}/qmd/index.sqlite on
      # a host where qmd never ran — doctor writes nothing, so the collection is
      # probed only when qmd's cache dir already exists.
      local qmd_cache listing
      qmd_cache="${XDG_CACHE_HOME:-$HOME/.cache}/qmd"
      if [[ ! -d "$qmd_cache" ]]; then
        _check warn qmd-collection "not probed (qmd never ran here: no $qmd_cache, and 'qmd collection list' would create its index) — run: qmd collection add $QMD_COLLECTION $VAULT_PATH --mode hybrid"
      elif listing="$(qmd collection list 2>/dev/null)"; then
        if printf '%s\n' "$listing" | awk -v c="$QMD_COLLECTION" '$1 == c { found = 1 } END { exit !found }'; then
          _check ok qmd-collection "$QMD_COLLECTION"
        else
          _check warn qmd-collection "collection '$QMD_COLLECTION' not in 'qmd collection list' — run: qmd collection add $QMD_COLLECTION $VAULT_PATH --mode hybrid"
        fi
      else
        _check warn qmd-collection "could not run 'qmd collection list' (skipped)"
      fi
    fi
  fi

  # engine
  local root_phys home_phys branch
  root_phys="$(_abs_dir "$MNEMON_ROOT")"
  if [[ -z "${MNEMON_HOME:-}" ]]; then
    _check warn engine "MNEMON_HOME not set (running from $root_phys)"
  else
    home_phys="$(_abs_dir "$MNEMON_HOME" 2>/dev/null || true)"
    if [[ -z "$home_phys" ]]; then
      _check warn engine "MNEMON_HOME=$MNEMON_HOME does not exist (running from $root_phys)"
    elif [[ "$home_phys" != "$root_phys" ]]; then
      _check warn engine "running from $root_phys, installed engine is $MNEMON_HOME"
    elif git -C "$home_phys" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      branch="$(git -C "$home_phys" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
      if [[ "$branch" == release ]]; then
        _check ok engine "$MNEMON_HOME (branch release)"
      else
        _check warn engine "$MNEMON_HOME is on branch $branch, expected release"
      fi
    else
      _check ok engine "$MNEMON_HOME"
    fi
  fi

  # engine-lock — is a `mnemon release` moving the engine right now?
  local lockf lstate=0
  lockf="$(mnemon_engine_lock_file)"
  mnemon_engine_lock_state || lstate=$?
  case "$lstate" in
    0) _check ok engine-lock "none ($lockf)" ;;
    1) _check warn engine-lock "engine update in progress since $(_mnemon_lock_field date "$lockf") (pid $(_mnemon_lock_field pid "$lockf"), target $(_mnemon_lock_field target "$lockf")) — other commands exit 75 until $lockf is removed" ;;
    2) _check warn engine-lock "stale lock $lockf (older than $((MNEMON_ENGINE_LOCK_MAX_AGE / 60)) min, ignored) — remove it if no release is running" ;;
  esac

  if $have_config; then
    # writer
    if [[ -z "$WRITER_HOST" ]]; then
      _check ok writer "writer_host not set (any host may write)"
    else
      local this_host
      this_host="$(_host)"
      if [[ "$this_host" == "$WRITER_HOST" ]]; then
        _check ok writer "this host ($this_host) is the writer"
      else
        _check fail writer "this host must not write vault $VAULT_PATH (writer_host $WRITER_HOST, this host $this_host)"
      fi
    fi

    # pending-writes
    local pdir="$VAULT_PATH/_inputs/pending-writes" n=0
    if [[ -d "$pdir" ]]; then
      n=$(find "$pdir" -type f -not -name '.*' 2>/dev/null | wc -l | tr -d ' ')
    fi
    if [[ "$n" -gt 0 ]]; then
      _check warn pending-writes "$n file(s) in $pdir"
    else
      _check ok pending-writes "none"
    fi
  fi

  local rc=0
  if [[ $DOCTOR_FAILS -gt 0 ]]; then rc=1; fi
  if $DOCTOR_JSON; then
    printf '{"checks":[%s],"exit":%d}\n' "$DOCTOR_ITEMS" "$rc"
  fi
  exit $rc
}

# ---------------------------------------------------------------------------
# config
# ---------------------------------------------------------------------------

CONFIG_EXPORTS="MNEMON_ROOT MNEMON_CONFIG MNEMON_CONFIG_FILE MNEMON_CONFIG_SOURCE MNEMON_INSTANCE MNEMON_STATE_DIR VAULT_PATH READER_CONTEXT_PATH CHARTER_PATH SEARCH_PROVIDER QMD_COLLECTION DEFAULT_MODEL DEFAULT_LANGUAGE WHISPER_MODEL AUTO_DETECT_ORIGIN ARCHIVE_DIR WRITER_HOST"

cmd_config_list() {
  local dir inst_dir def f name vault marker count=0
  dir="$(mnemon_config_dir)"
  inst_dir="$dir/instances"
  def="$(_mnemon_default_instance "$dir/default" 2>/dev/null || true)"
  if [[ -d "$inst_dir" ]]; then
    for f in "$inst_dir"/*.yaml; do
      [[ -f "$f" ]] || continue
      name="$(basename "$f" .yaml)"
      vault="$(_parse_yaml_value vault_path "$f")"
      marker=" "
      if [[ "$name" == "$def" ]]; then marker="*"; fi
      printf '%s %-16s %s\n' "$marker" "$name" "$vault"
      count=$((count + 1))
    done
  fi
  if [[ -n "$def" && ! -f "$inst_dir/$def.yaml" ]]; then
    printf '! %-16s (stale default: %s names it, but %s does not exist — the next `mnemon init` takes the default over)\n' "$def" "$dir/default" "$inst_dir/$def.yaml"
  fi
  if [[ $count -eq 0 ]]; then
    printf 'no instances in %s\n  create one with: mnemon init <name> --vault <path>\n' "$inst_dir" >&2
  fi
}

cmd_config() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || usage_error "config: expected get <key> | path | list | dump"
  shift
  case "$sub" in
    get)
      local key="${1:-}" var=""
      [[ -n "$key" ]] || usage_error "config get: key required"
      case "$key" in
        vault_path)          var=VAULT_PATH ;;
        reader_context_path) var=READER_CONTEXT_PATH ;;
        archive_dir)         var=ARCHIVE_DIR ;;
        qmd_collection)      var=QMD_COLLECTION ;;
        search_provider)     var=SEARCH_PROVIDER ;;
        default_model)       var=DEFAULT_MODEL ;;
        default_language)    var=DEFAULT_LANGUAGE ;;
        whisper_model)       var=WHISPER_MODEL ;;
        auto_detect_origin)  var=AUTO_DETECT_ORIGIN ;;
        state_dir)           var=MNEMON_STATE_DIR ;;
        charter_path)        var=CHARTER_PATH ;;
        writer_host)         var=WRITER_HOST ;;
        instance)            var=MNEMON_INSTANCE ;;
        config_file)         var=MNEMON_CONFIG_FILE ;;
        config_source)       var=MNEMON_CONFIG_SOURCE ;;
        config_dir)          mnemon_config_dir; echo; return 0 ;;
        *) printf 'mnemon config get: unknown key %s\n' "$key" >&2; exit 2 ;;
      esac
      _resolve_or_die
      printf '%s\n' "${!var}" ;;
    path)
      _resolve_or_die
      printf '%s\n' "$MNEMON_CONFIG_FILE" ;;
    list)
      cmd_config_list ;;
    dump)
      _resolve_or_die
      local v
      printf 'MNEMON_CONFIG_DIR=%s\n' "$(mnemon_config_dir)"
      for v in $CONFIG_EXPORTS; do
        printf '%s=%s\n' "$v" "${!v}"
      done ;;
    *) usage_error "config: unknown subcommand '$sub' (expected get | path | list | dump)" ;;
  esac
}

# ---------------------------------------------------------------------------
# release — main → release → installed engine ($MNEMON_HOME)
# ---------------------------------------------------------------------------

RELEASE_LOCK=""
_release_lock_release() {
  if [[ -n "$RELEASE_LOCK" ]]; then
    rm -f "$RELEASE_LOCK"
    echo "release: lock removed ($RELEASE_LOCK)"
    RELEASE_LOCK=""
  fi
}

# Create the maintenance lock (refuse a fresh one, take over a stale one) and
# arrange for its removal on every exit path.
_release_lock_acquire() {
  local f="$1" target="$2" state=0
  mnemon_engine_lock_state || state=$?
  if [[ $state -eq 1 ]]; then
    echo "mnemon release: another engine update holds $f (pid $(_mnemon_lock_field pid "$f"), since $(_mnemon_lock_field date "$f")); retry later" >&2
    exit 75
  elif [[ $state -eq 2 ]]; then
    echo "release: taking over a stale lock $f (older than $((MNEMON_ENGINE_LOCK_MAX_AGE / 60)) min)"
  fi
  mkdir -p "$(dirname "$f")"
  printf 'pid=%s\ntimestamp=%s\ndate=%s\ntarget=%s\n' "$$" "$(date +%s)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$target" > "$f"
  RELEASE_LOCK="$f"
  export MNEMON_ENGINE_LOCK_OWNER="$$"
  trap '_release_lock_release' EXIT
  echo "release: lock $f (pid $$, target $target)"
}

# PIDs of engine processes whose command line matches the drain pattern $1
# (see _drain_pattern) — pgrep -f, same user and host only (documented
# limitation); never this process or its parent.
_engine_pids() {
  pgrep -f -- "$1" 2>/dev/null | grep -v -x -e "$$" -e "$PPID" | tr '\n' ' ' | sed 's/ *$//' || true
}

# Wait up to $2 seconds for engine processes under $1 (matched by the drain
# pattern $3) to finish; 1 on timeout.
_release_drain() {
  local home="$1" timeout="$2" pattern="$3" waited=0 pids
  while :; do
    pids="$(_engine_pids "$pattern")"
    if [[ -z "$pids" ]]; then
      echo "release: drain — no engine processes running from $home/bin/"
      return 0
    fi
    if [[ $waited -ge $timeout ]]; then
      echo "mnemon release: engine busy after ${timeout}s — still running from $home/bin/: $pids" >&2
      echo "  nothing was changed; wait for them to finish or raise --drain-timeout <s>" >&2
      return 1
    fi
    if [[ $waited -eq 0 ]]; then echo "release: drain — waiting up to ${timeout}s for engine processes to finish ($pids)"; fi
    sleep 1
    waited=$((waited + 1))
  done
}

# Smoke = engine health only: config resolves, version reports the new commit,
# tests/test_config.sh passes, doctor has no fail line other than the
# environmental deps/qmd/writer. MNEMON_SMOKE_CMD replaces the checks — a test
# hook, honoured only together with MNEMON_TEST_HOOKS=1 so a stray variable in a
# production environment can never stand in for the smoke.
_release_smoke() {
  local home="$1" new_sha="$2" ok=true out log bad
  if [[ -n "${MNEMON_SMOKE_CMD:-}" ]]; then
    if [[ "${MNEMON_TEST_HOOKS:-}" == 1 ]]; then
      echo "release: smoke — MNEMON_SMOKE_CMD override (MNEMON_TEST_HOOKS=1): $MNEMON_SMOKE_CMD"
      if bash -c "$MNEMON_SMOKE_CMD"; then return 0; else return 1; fi
    fi
    echo "mnemon release: ignoring MNEMON_SMOKE_CMD — a test hook, honoured only with MNEMON_TEST_HOOKS=1; running the real smoke" >&2
  fi
  echo "release: smoke — $home/bin/mnemon config path"
  if out="$("$home/bin/mnemon" config path 2>&1)"; then echo "  $out"; else printf '%s\n' "$out" | sed 's/^/  /'; ok=false; fi
  echo "release: smoke — $home/bin/mnemon version"
  if out="$("$home/bin/mnemon" version 2>&1)"; then echo "  $out"; else printf '%s\n' "$out" | sed 's/^/  /'; ok=false; fi
  case "$out" in *"$new_sha"*) ;; *) echo "  ✗ version does not report $new_sha" >&2; ok=false ;; esac
  echo "release: smoke — bash $home/tests/test_config.sh"
  log="$(mktemp)"
  if bash "$home/tests/test_config.sh" >"$log" 2>&1; then echo "  $(tail -1 "$log")"; else cat "$log"; ok=false; fi
  rm -f "$log"
  echo "release: smoke — $home/bin/mnemon doctor (fail lines other than deps/qmd/writer fail the release)"
  out="$("$home/bin/mnemon" doctor 2>&1)" || true
  printf '%s\n' "$out" | sed 's/^/  /'
  bad="$(printf '%s\n' "$out" | grep '^fail ' | grep -v -e '^fail deps' -e '^fail qmd' -e '^fail writer' || true)"
  if [[ -n "$bad" ]]; then
    echo "  ✗ engine-health failures:" >&2
    printf '%s\n' "$bad" | sed 's/^/    /' >&2
    ok=false
  fi
  $ok
}

cmd_release() {
  local dry=false now=false rollback="" drain_timeout=120
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)       dry=true; shift ;;
      --now)           now=true; shift ;;
      --rollback)      [[ $# -lt 2 ]] && usage_error "release: --rollback requires a ref"; rollback="$2"; shift 2 ;;
      --drain-timeout) [[ $# -lt 2 ]] && usage_error "release: --drain-timeout requires a number of seconds"; drain_timeout="$2"; shift 2 ;;
      -h|--help)       usage; exit 0 ;;
      *)               usage_error "release: unknown option $1" ;;
    esac
  done
  [[ "$drain_timeout" =~ ^[0-9]+$ ]] || usage_error "release: --drain-timeout must be a number of seconds"

  # --- preflight: read-only checks ---
  local home="${MNEMON_HOME:-}" home_given drain_pattern
  [[ -n "$home" ]] || die "release: MNEMON_HOME is not set (it must point at the installed engine worktree on branch release)"
  [[ -d "$home" ]] || die "release: MNEMON_HOME=$home does not exist"
  # Normalize once: `home` is the canonical physical path (no trailing slash,
  # symlinks resolved); `home_given` keeps the spelling MNEMON_HOME used, for the
  # drain pattern — "engine/" would otherwise look for "engine//bin/" and match nothing.
  home_given="$(_strip_trailing_slashes "$(_expand_tilde "$home")")"
  case "$home_given" in /*) ;; *) home_given="$PWD/$home_given" ;; esac
  home="$(_abs_dir "$home_given")" || die "release: cannot resolve MNEMON_HOME=$MNEMON_HOME"
  drain_pattern="$(_drain_pattern "$home" "$home_given")"
  git -C "$home" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "release: $home is not a git worktree"
  git -C "$MNEMON_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "release: dev tree $MNEMON_ROOT is not a git worktree"
  local home_branch
  home_branch="$(git -C "$home" rev-parse --abbrev-ref HEAD)"
  [[ "$home_branch" == release ]] || die "release: $home is on branch '$home_branch', expected 'release'"
  local dev_common home_common
  dev_common="$(_git_common_dir "$MNEMON_ROOT")" || die "release: cannot read git dir of $MNEMON_ROOT"
  home_common="$(_git_common_dir "$home")" || die "release: cannot read git dir of $home"
  [[ "$dev_common" == "$home_common" ]] || die "release: $home is not a worktree of this repo ($home_common != $dev_common)"
  if [[ "$(_abs_dir "$MNEMON_ROOT")" == "$(_abs_dir "$home")" ]]; then
    die "release: run it from the dev tree, not from the installed engine ($home) — files under a running script must not move"
  fi
  git -C "$MNEMON_ROOT" rev-parse --verify -q main >/dev/null || die "release: no 'main' branch in $MNEMON_ROOT"

  local lock prev main_sha dev_branch dev_sha dirty="clean" ancestor="yes" target_sha
  lock="$(mnemon_engine_lock_file)"
  prev="$(git -C "$home" rev-parse --short HEAD)"
  main_sha="$(git -C "$MNEMON_ROOT" rev-parse --short main)"
  dev_branch="$(git -C "$MNEMON_ROOT" rev-parse --abbrev-ref HEAD)"
  dev_sha="$(git -C "$MNEMON_ROOT" rev-parse --short HEAD)"
  if [[ -n "$(git -C "$MNEMON_ROOT" status --porcelain --untracked-files=no)" ]]; then dirty="DIRTY (uncommitted tracked changes)"; fi
  if ! git -C "$MNEMON_ROOT" merge-base --is-ancestor release main 2>/dev/null; then ancestor="NO — release has diverged from main"; fi
  if [[ -n "$rollback" ]]; then
    target_sha="$(git -C "$home" rev-parse --short --verify -q "$rollback^{commit}" 2>/dev/null)" || die "release: --rollback: unknown ref '$rollback'"
  else
    target_sha="$main_sha"
  fi
  local rollback_cmds="  mnemon release --rollback $prev
    = git -C $home reset --hard $prev
      git -C $home push --force-with-lease origin release   (only if origin/release had already moved)"

  if $dry; then
    echo "mnemon release — dry run (nothing changes)"
    echo "  dev tree:  $MNEMON_ROOT ($dev_branch @ $dev_sha, $dirty)"
    if [[ "$home" == "$home_given" ]]; then
      echo "  installed: $home (release @ $prev)"
    else
      echo "  installed: $home (release @ $prev; MNEMON_HOME=$MNEMON_HOME)"
    fi
    echo "  main:      $main_sha"
    echo "  1. lock:   $lock (pid, timestamp, target $target_sha); removed last, also on failure"
    echo "  2. drain:  wait up to ${drain_timeout}s for processes matching: pgrep -f $drain_pattern"
    if [[ -n "$rollback" ]]; then
      echo "  3. reset:  git -C $home reset --hard $rollback   ($prev → $target_sha)"
      echo "  4. print:  git -C $home push --force-with-lease origin release   (not run)"
      echo "  5. unlock: rm $lock"
    else
      echo "  3. check:  git -C $MNEMON_ROOT status --porcelain --untracked-files=no   → $dirty"
      echo "  4. fetch:  git -C $MNEMON_ROOT fetch origin"
      echo "  5. check:  git -C $MNEMON_ROOT merge-base --is-ancestor release main   → $ancestor"
      echo "  6. merge:  git -C $home merge --ff-only main   ($prev → $main_sha)"
      echo "  7. smoke:  $home/bin/mnemon config path · $home/bin/mnemon version (reports $main_sha) · bash $home/tests/test_config.sh · $home/bin/mnemon doctor (no fail other than deps/qmd/writer)"
      echo "  8. push:   git -C $home push origin release   (only after a green smoke)"
      if $now; then echo "  9. ping:   node ping not implemented (program phase 4)"; fi
      echo "  unlock:    rm $lock"
      echo "  rollback:"
      echo "$rollback_cmds"
    fi
    exit 0
  fi

  # --- 1. lock (removed by trap on every exit) · 2. drain ---
  _release_lock_acquire "$lock" "$target_sha"
  _release_drain "$home" "$drain_timeout" "$drain_pattern" || exit 1

  # --- rollback: reset under the lock, print the push ---
  if [[ -n "$rollback" ]]; then
    echo "release: rollback $home  $prev → $target_sha"
    git -C "$home" reset --hard "$rollback"
    echo "rolled back $home to $(git -C "$home" rev-parse --short HEAD); origin/release was not touched — publish the rollback by hand if it had been pushed:"
    echo "  git -C $home push --force-with-lease origin release"
    exit 0
  fi

  # --- 3. dev tree clean ---
  if [[ "$dirty" != clean ]]; then
    die "release: dev tree $MNEMON_ROOT has uncommitted tracked changes — commit or stash first"
  fi
  # --- 4. fetch (non-fatal) ---
  if ! git -C "$MNEMON_ROOT" fetch origin >/dev/null 2>&1; then
    echo "mnemon release: warning — 'git fetch origin' failed (offline?); continuing with local refs" >&2
  fi
  # --- 5. release must be an ancestor of main ---
  if ! git -C "$MNEMON_ROOT" merge-base --is-ancestor release main 2>/dev/null; then
    die "release: release has diverged from main (release=$(git -C "$MNEMON_ROOT" rev-parse --short release), main=$main_sha) — reconcile manually"
  fi
  # --- 6. ff-merge: moves the release branch and the installed worktree together ---
  echo "release: $home  $prev → $main_sha (ff-only merge of main)"
  if ! git -C "$home" merge --ff-only main; then
    die "release: ff-merge failed — roll back with: git -C $home reset --hard $prev"
  fi
  # --- 7. smoke on the updated worktree; a failure never publishes ---
  if ! _release_smoke "$home" "$main_sha"; then
    {
      echo "mnemon release: smoke failed on $home @ $main_sha. Nothing was pushed. Roll back with:"
      echo "$rollback_cmds"
    } >&2
    exit 1
  fi
  # --- 8. push: the local release stands either way, but nodes pull origin/release ---
  local new_sha
  new_sha="$(git -C "$home" rev-parse --short HEAD)"
  if ! git -C "$home" push origin release >/dev/null 2>&1; then
    {
      echo "mnemon release: released locally to $home, push failed: nodes will not see $new_sha"
      echo "  origin/release did not move (offline? no access?) — push by hand before nodes pull: git -C $home push origin release"
    } >&2
    exit 3
  fi
  if $now; then echo "node ping not implemented (program phase 4)"; fi
  echo "released $new_sha → $home"
}

# ---------------------------------------------------------------------------
# version
# ---------------------------------------------------------------------------

cmd_version() {
  local desc branch sha
  if git -C "$MNEMON_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    desc="$(git -C "$MNEMON_ROOT" describe --tags --always --dirty 2>/dev/null || echo unknown)"
    branch="$(git -C "$MNEMON_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    sha="$(git -C "$MNEMON_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  else
    desc="unknown"
    branch="no-git"
    sha="unknown"
  fi
  printf 'mnemon %s (%s, %s) %s\n' "$desc" "$branch" "$sha" "$MNEMON_ROOT"
}

# ---------------------------------------------------------------------------
# Global options + dispatch
# ---------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
  case "$1" in
    --instance)   [[ $# -lt 2 ]] && usage_error "--instance requires a value"; _select_instance "$2"; shift 2 ;;
    --instance=*) _select_instance "${1#--instance=}"; shift ;;
    --config)     [[ $# -lt 2 ]] && usage_error "--config requires a value"; _select_config "$2"; shift 2 ;;
    --config=*)   _select_config "${1#--config=}"; shift ;;
    -h|--help)    set -- help; break ;;
    --)           shift; break ;;
    -*)           usage_error "unknown option: $1" ;;
    *)            break ;;
  esac
done
[[ $# -gt 0 ]] || usage_error "a command is required"
cmd="$1"
shift
_apply_selectors

# Engine maintenance lock (A3): everything but `release` (holds it) and `doctor`
# (reports it) exits 75 while the installed engine is being updated.
case "$cmd" in
  release|doctor) ;;
  *) mnemon_engine_lock_guard ;;
esac

case "$cmd" in
  add)      _reject_post_command_selectors "$@"; _resolve_or_die
            exec "$BIN_DIR/knowledge-gateway.sh" source-add "$@" ;;
  status)   _reject_post_command_selectors "$@"; _resolve_or_die
            exec "$BIN_DIR/knowledge-gateway.sh" status "$@" ;;
  search)   if ! _has_flag --vault "$@"; then _resolve_or_die; fi
            exec python3 "$BIN_DIR/mnemon-search.py" "$@" ;;
  reindex)  _resolve_or_die; exec python3 "$BIN_DIR/knowledge-reindex.py" "$VAULT_PATH" "$@" ;;
  triage)   _resolve_or_die; exec python3 "$BIN_DIR/triage-urls.py" --vault "$VAULT_PATH" "$@" ;;
  audit)    _resolve_or_die; exec python3 "$BIN_DIR/archive-audit.py" --config "$MNEMON_CONFIG_FILE" "$@" ;;
  init)     cmd_init "$@" ;;
  doctor)   cmd_doctor "$@" ;;
  config)   cmd_config "$@" ;;
  release)  cmd_release "$@" ;;
  version)  cmd_version ;;
  ingest|scan|monitor)
    printf 'mnemon %s: not implemented yet (program phase 4)\n' "$cmd" >&2
    exit 2 ;;
  help|-h|--help) usage; exit 0 ;;
  *) usage_error "unknown command: $cmd" ;;
esac
