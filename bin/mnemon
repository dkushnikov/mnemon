#!/usr/bin/env bash
# mnemon — command dispatcher for the Mnemon engine.
#
#   mnemon [--instance <name>] [--config <path>] <command> [args…]
#
# MNEMON_ROOT is this script's own repo root (symlinks resolved), so a symlink
# such as ~/.local/bin/mnemon → $MNEMON_HOME/bin/mnemon works. Subcommands that
# need configuration call load_config (bin/mnemon-config.sh) and fail with its
# message. bash 3.2 compatible: no associative arrays, no ${var,,}, no mapfile.
set -euo pipefail

# --- Locate the engine root: resolve symlinks of $0 without readlink -f ---
_self="${BASH_SOURCE[0]:-$0}"
while [[ -L "$_self" ]]; do
  _target="$(readlink "$_self")"
  case "$_target" in
    /*) _self="$_target" ;;
    *)  _self="$(dirname "$_self")/$_target" ;;
  esac
done
MNEMON_ROOT="$(cd "$(dirname "$_self")/.." && pwd -P)"
export MNEMON_ROOT
BIN_DIR="$MNEMON_ROOT/bin"
# shellcheck source=mnemon-config.sh
source "$BIN_DIR/mnemon-config.sh"

usage() {
  cat <<'USAGE'
Usage: mnemon [--instance <name>] [--config <path>] <command> [args...]

Commands:
  add <gateway options>      Capture a source (knowledge-gateway.sh source-add)
  status [--brief [--json] [--budget <s>]]
                             Pipeline status for the instance; --brief prints one line of the
                             vault store (counters + the data checks' summary; read-only, the
                             folder walk stops at --budget seconds, default 10, and says so)
  site map <url> [--max-pages N] [--include <re>]… [--exclude <re>]… [--out <plan.json>] [--json]
                             Discover a site's pages into a reviewable plan for `add --site`
                             (a regex is searched in the page's path plus ?query, e.g. ^/blog/;
                             --include keeps the landing and only the matching pages, --exclude
                             then removes, the cap applies last)
  search --query <q> [...]   Search extracts (JSON; --human for text)
  reindex [--no-hand-edit-report]
                             Rebuild the vault's index.md from Sources/: every row regenerated,
                             replaced rows preserved in _inputs/index-hand-edits-<date>.md
                             (the flag skips that step)
  triage <input> [...]       Content-aware URL triage against the vault
  audit [--cutoff DATE]      Archive consistency audit
  audit --canonical          Folders whose URLs coincide under canonicalization v1 (read-only)
  init <name> --vault <path> [--archive <dir>] [--collection <name>]
       [--search-provider grep|qmd] [--reader-context <path> | --reader-context-path <path>]
       [--charter <path>] [--writer-host <host>] [--default] [--force] [--non-interactive]
                             Create an instance config and scaffold its vault (never
                             overwrites vault files). --reader-context copies a profile
                             into the vault; --reader-context-path points at one in place;
                             with neither, an existing _meta/reader-context.md or
                             reader-context.md in the vault is used, else the template
  ingest <inbox-dir> [--dry-run] [--only <envelope_id>] [--limit N] [--max-attempts N]
         [--retry <envelope_id>] [--json]
                             Consume mnemon-envelope/1 files from an inbox directory under
                             the vault lock; one result record per envelope (docs/inbox.md)
  fence-probe                Probe the extractor fence of the installed Claude Code and
                             record a pass for its version (needed before extraction)
  doctor [--instance <name>] [--json] [--data [--list <check>]]
                             Health checks: ok|warn|fail <check> — <detail>; --data adds the
                             19 vault store checks (store/… data/… human/…; docs/specs/
                             2026-10-16-vault-store.md), --list <check> prints every item of
                             one of them (<id> <class or reason> <rating> <words>, tab-separated)
  config get <key> | path | list | keys | dump
                             Resolved configuration (keys: the scalar keys and defaults)
  release [--dry-run] [--now] [--drain-timeout <s>] [--rollback <ref>]
                             Maintainer: promote main → release → installed engine
                             (lock → drain → ff-merge → smoke → push); --rollback resets
                             the engine to <ref> under the same lock
  version                    Engine version, branch, commit and root
  help                       This text
  scan | monitor             Reserved (program phase 4)

Global options (one of them; both on one command line → exit 2):
  --instance <name>          Select an instance   (exports MNEMON_INSTANCE, drops an inherited MNEMON_CONFIG)
  --config <path>            Explicit config file (exports MNEMON_CONFIG, drops an inherited MNEMON_INSTANCE)

Config resolution — explicit beats inherited: --config → --instance → $MNEMON_CONFIG →
$MNEMON_INSTANCE → ./mnemon.yaml → $MNEMON_CONFIG_DIR/default → legacy mnemon.yaml (warns).
$MNEMON_CONFIG and $MNEMON_INSTANCE both set must agree (same file, or the file declares
that instance), otherwise exit 2. The dispatcher resolves once and exports the pair to the
command. MNEMON_CONFIG_DIR defaults to ${XDG_CONFIG_HOME:-~/.config}/mnemon; instances live
in its instances/ folder.
USAGE
}

die() { printf 'mnemon: %s\n' "$*" >&2; exit 1; }
usage_error() { printf 'mnemon: %s\n\n' "$*" >&2; usage >&2; exit 2; }

# Physical path of an existing directory.
_abs_dir() { (cd "$1" 2>/dev/null && pwd -P); }

_expand_tilde() { _mnemon_expand_tilde "$1"; }

# Tilde-free absolute path; the parent must exist, the leaf need not.
_abs_path() {
  local p d
  p="$(_expand_tilde "$1")"
  case "$p" in /*) ;; *) p="$PWD/$p" ;; esac
  d="$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)" || { printf '%s' "$p"; return 0; }
  if [[ "$d" == "/" ]]; then printf '/%s' "$(basename "$p")"; else printf '%s/%s' "$d" "$(basename "$p")"; fi
}

# Escape a replacement string for `sed s|...|...|`.
_sed_esc() { printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'; }

# Short host name (hostname -s, falling back to the first label of hostname).
_host() {
  local h
  h="$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo unknown)"
  printf '%s' "${h%%.*}"
}

# --- Instance selection (A1): a flag outranks the inherited environment ---
CLI_CONFIG=""
CLI_INSTANCE=""
_select_config()   { CLI_CONFIG="$(_abs_path "$1")"; }
_select_instance() { CLI_INSTANCE="$1"; }
# Export the flag's selector and drop the other inherited one; refuse both flags.
_apply_selectors() {
  if [[ -n "$CLI_CONFIG" && -n "$CLI_INSTANCE" ]]; then
    usage_error "conflicting selectors: --config and --instance on one command line (use one)"
  fi
  if [[ -n "$CLI_CONFIG" ]]; then
    export MNEMON_CONFIG="$CLI_CONFIG" MNEMON_SELECTED_BY="--config"
    unset MNEMON_INSTANCE MNEMON_CONFIG_SOURCE
  elif [[ -n "$CLI_INSTANCE" ]]; then
    export MNEMON_INSTANCE="$CLI_INSTANCE" MNEMON_SELECTED_BY="--instance"
    unset MNEMON_CONFIG MNEMON_CONFIG_SOURCE
  fi
}
# Resolve once; the exported MNEMON_CONFIG + MNEMON_INSTANCE pair is what children see.
_resolve_or_die() { load_config || exit $?; }
# Selectors are global options; a child must never re-decide (`mnemon add --instance x` is refused).
_reject_post_command_selectors() {
  local a
  for a in "$@"; do
    case "$a" in
      --config|--config=*)     usage_error "${a%%=*} belongs before the command: mnemon --config <path> <command> …" ;;
      --instance|--instance=*) usage_error "${a%%=*} belongs before the command: mnemon --instance <name> <command> …" ;;
    esac
  done
}
_has_flag() {
  local want="$1" a; shift
  for a in "$@"; do
    case "$a" in "$want"|"$want"=*) return 0 ;; esac
  done
  return 1
}

# JSON string body (no surrounding quotes).
_json_str() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n\t' '  '; }

# Absolute physical path of a worktree's common git dir (same repo ⇔ same value).
_git_common_dir() {
  local d
  d="$(git -C "$1" rev-parse --git-common-dir 2>/dev/null)" || return 1
  case "$d" in /*) ;; *) d="$1/$d" ;; esac
  (cd "$d" 2>/dev/null && pwd -P)
}

# Path without trailing slashes ("/" stays "/").
_strip_trailing_slashes() {
  local p="$1"
  while [[ "$p" == */ && "$p" != / ]]; do p="${p%/}"; done
  printf '%s' "$p"
}

# Escape every ERE metacharacter so a path can be used literally in pgrep -f.
_re_escape() { printf '%s' "$1" | sed -e 's/[]\\.^$*+?(){}|[]/\\&/g'; }

# pgrep -f pattern for engine processes under <home>/bin/ in both spellings of
# the engine path: the physical one ($1) and the one MNEMON_HOME was given as
# ($2) — a process started through a symlinked MNEMON_HOME carries the symlink
# spelling on its command line.
_drain_pattern() {
  local phys="$1" given="$2"
  if [[ "$phys" == "$given" ]]; then
    printf '%s/bin/' "$(_re_escape "$phys")"
  else
    printf '(%s|%s)/bin/' "$(_re_escape "$phys")" "$(_re_escape "$given")"
  fi
}

# Closest existing ancestor of a path (the path itself if it exists).
_nearest_existing_parent() {
  local p="$1"
  while [[ -n "$p" && "$p" != "/" && ! -e "$p" ]]; do p="$(dirname "$p")"; done
  if [[ -e "$p" ]]; then printf '%s' "$p"; fi
}

# Copy src → dst unless dst exists (never overwrite vault files).
_copy_if_missing() {
  local src="$1" dst="$2" label="$3"
  if [[ -f "$dst" ]]; then
    echo "  ○ skipped $label (exists)"
  elif [[ ! -f "$src" ]]; then
    echo "  ○ skipped $label (no template at $src)"
  else
    mkdir -p "$(dirname "$dst")"
    cp "$src" "$dst"
    echo "  ✓ created $label"
  fi
}

# YAML double-quoted scalar: `\` and `"` escaped (the loader decodes exactly
# these two), wrapped in quotes — a space or a ` #` in a path survives.
_yaml_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
_yaml_dq()  { printf '"%s"' "$(_yaml_esc "$1")"; }

# Set `key: value` in a flat yaml file: replace an existing line, uncomment a
# `# key:` template line, or append. The value is written double-quoted unless
# $4 is `raw` (enum-like values such as search_provider stay bare and greppable).
_yaml_set() {
  local file="$1" key="$2" value="$3" mode="${4:-}" tmp rendered
  if [[ "$mode" == raw ]]; then rendered="$value"; else rendered="$(_yaml_dq "$value")"; fi
  tmp="$(mktemp "$file.XXXXXX")"
  if grep -q "^$key:" "$file" 2>/dev/null; then
    sed -e "s|^$key:.*|$key: $(_sed_esc "$rendered")|" "$file" > "$tmp"
  elif grep -q "^# $key:" "$file" 2>/dev/null; then
    sed -e "s|^# $key:.*|$key: $(_sed_esc "$rendered")|" "$file" > "$tmp"
  else
    cat "$file" > "$tmp"
    printf '%s: %s\n' "$key" "$rendered" >> "$tmp"
  fi
  mv "$tmp" "$file"
}

# ---------------------------------------------------------------------------
# init
# ---------------------------------------------------------------------------

cmd_init() {
  local name="" vault="" archive="" collection="" reader_src="" reader_path="" charter="" writer_host=""
  local search_provider="grep" set_default=false force=false non_interactive=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --vault)           [[ $# -lt 2 ]] && usage_error "init: --vault requires a path"; vault="$2"; shift 2 ;;
      --archive)         [[ $# -lt 2 ]] && usage_error "init: --archive requires a dir"; archive="$2"; shift 2 ;;
      --collection)      [[ $# -lt 2 ]] && usage_error "init: --collection requires a name"; collection="$2"; shift 2 ;;
      --search-provider) [[ $# -lt 2 ]] && usage_error "init: --search-provider requires grep or qmd"; search_provider="$2"; shift 2 ;;
      --reader-context)  [[ $# -lt 2 ]] && usage_error "init: --reader-context requires a path"; reader_src="$2"; shift 2 ;;
      --reader-context-path) [[ $# -lt 2 ]] && usage_error "init: --reader-context-path requires a path"; reader_path="$2"; shift 2 ;;
      --charter)         [[ $# -lt 2 ]] && usage_error "init: --charter requires a path"; charter="$2"; shift 2 ;;
      --writer-host)     [[ $# -lt 2 ]] && usage_error "init: --writer-host requires a host"; writer_host="$2"; shift 2 ;;
      --default)         set_default=true; shift ;;
      --force)           force=true; shift ;;
      --non-interactive) non_interactive=true; shift ;;
      -h|--help)         usage; exit 0 ;;
      -*)                usage_error "init: unknown option $1" ;;
      *)
        [[ -z "$name" ]] || usage_error "init: unexpected argument '$1'"
        name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || usage_error "init: instance name required"
  local name_re='^[A-Za-z0-9][A-Za-z0-9._-]*$'
  [[ "$name" =~ $name_re ]] || die "init: invalid instance name '$name' (letters, digits, . _ - ; must start with a letter or digit)"
  [[ "$name" != "$MNEMON_ADHOC_INSTANCE" ]] || die "init: '$MNEMON_ADHOC_INSTANCE' is reserved for configs loaded by path"
  case "$search_provider" in
    grep|qmd) ;;
    *) usage_error "init: --search-provider must be grep or qmd (got '$search_provider')" ;;
  esac
  if [[ -n "$reader_src" && -n "$reader_path" ]]; then
    usage_error "init: --reader-context (copy a profile into the vault) and --reader-context-path (point at one in place) exclude each other"
  fi

  if [[ -z "$vault" ]]; then
    if ! $non_interactive && [[ -t 0 ]]; then
      printf 'Vault path for instance %s: ' "$name" >&2
      IFS= read -r vault || vault=""
    fi
    [[ -n "$vault" ]] || usage_error "init: --vault <path> required"
  fi

  local cfg_dir inst_dir inst_file template
  cfg_dir="$(mnemon_config_dir)"
  inst_dir="$cfg_dir/instances"
  inst_file="$inst_dir/$name.yaml"
  template="$MNEMON_ROOT/mnemon.yaml.template"
  [[ -f "$template" ]] || die "init: template not found: $template"
  if [[ -f "$inst_file" ]] && ! $force; then
    die "init: instance '$name' already exists at $inst_file (use --force to overwrite the config; vault files are never overwritten)"
  fi

  # --- Preflight: refuse before anything is written (no scaffold, no config) ---
  local archive_note=""
  if [[ -n "$reader_src" ]]; then
    reader_src="$(_abs_path "$reader_src")"
    [[ -f "$reader_src" ]] || die "init: reader context not found: $reader_src"
  fi
  if [[ -n "$reader_path" ]]; then
    reader_path="$(_abs_path "$reader_path")"
    [[ -f "$reader_path" ]] || die "init: --reader-context-path: no such file: $reader_path"
  fi
  if [[ -n "$archive" ]]; then
    # the user's explicit choice: create it now, or refuse before the vault is touched
    archive="$(_abs_path "$archive")"
    if [[ -d "$archive" ]]; then
      archive_note="  ○ archive dir exists: $archive"
    elif mkdir -p "$archive" 2>/dev/null; then
      archive_note="  ✓ created archive dir $archive"
    else
      die "init: cannot create archive dir $archive (choose a writable --archive path)"
    fi
  fi

  # Vault: create and make tilde-free absolute.
  vault="$(_expand_tilde "$vault")"
  mkdir -p "$vault" || die "init: cannot create vault directory $vault"
  vault="$(_abs_dir "$vault")"

  echo "=== mnemon init: $name ==="
  echo "Vault:  $vault"
  echo "Config: $inst_file"
  echo ""

  # 1. Vault scaffold (like setup.sh steps 1–2; never overwrites)
  echo "1. Vault scaffold"
  mkdir -p "$vault/Sources" "$vault/Synthesis" "$vault/_meta"
  echo "  ✓ Sources/ Synthesis/ _meta/"
  _copy_if_missing "$MNEMON_ROOT/vault-template/CLAUDE.md" "$vault/CLAUDE.md" "CLAUDE.md"
  _copy_if_missing "$MNEMON_ROOT/vault-template/_meta/Protocol.md" "$vault/_meta/Protocol.md" "_meta/Protocol.md"
  # Reader context — what reader_context_path will point at: an explicit flag
  # wins (--reader-context copies, --reader-context-path references); otherwise an
  # existing profile in the vault is used as it is; only a vault without one gets
  # the template.
  local reader_context="$vault/reader-context.md"
  if [[ -n "$reader_src" ]]; then
    _copy_if_missing "$reader_src" "$vault/reader-context.md" "reader-context.md (from $reader_src)"
  elif [[ -n "$reader_path" ]]; then
    echo "  ○ reader context: $reader_path (referenced in place, nothing copied)"
    reader_context="$reader_path"
  elif [[ -f "$vault/_meta/reader-context.md" ]]; then
    echo "  ○ reader context: existing _meta/reader-context.md (kept; template not placed)"
    if [[ -f "$vault/reader-context.md" ]]; then
      echo "    (the vault also has reader-context.md — pass --reader-context-path to choose it)"
    fi
    reader_context="$vault/_meta/reader-context.md"
  elif [[ -f "$vault/reader-context.md" ]]; then
    echo "  ○ reader context: existing reader-context.md (kept)"
  else
    _copy_if_missing "$MNEMON_ROOT/reader-context.md.template" "$vault/reader-context.md" "reader-context.md (generic — edit to personalize)"
  fi
  _copy_if_missing "$MNEMON_ROOT/mnemon-seed.md" "$vault/mnemon-seed.md" "mnemon-seed.md (reader profile builder)"

  # 2. Instance config from the template
  echo "2. Instance config"
  mkdir -p "$inst_dir"
  local tmp
  tmp="$(mktemp "$inst_dir/.$name.XXXXXX")"
  # The template holds the placeholders inside double quotes: YAML-escape, then sed-escape.
  sed -e "s|{{instance}}|$(_sed_esc "$(_yaml_esc "$name")")|g" \
      -e "s|{{vault_path}}|$(_sed_esc "$(_yaml_esc "$vault")")|g" \
      "$template" > "$tmp"
  _yaml_set "$tmp" search_provider "$search_provider" raw
  _yaml_set "$tmp" reader_context_path "$reader_context"
  if [[ -n "$collection" ]];  then _yaml_set "$tmp" qmd_collection "$collection"; fi
  if [[ -n "$archive" ]]; then
    echo "$archive_note"
    _yaml_set "$tmp" archive_dir "$archive"
  fi
  if [[ -n "$charter" ]];     then _yaml_set "$tmp" charter_path "$(_abs_path "$charter")"; fi
  if [[ -n "$writer_host" ]]; then _yaml_set "$tmp" writer_host "$writer_host"; fi
  mv "$tmp" "$inst_file"
  if $force; then echo "  ✓ wrote $inst_file (overwritten)"; else echo "  ✓ wrote $inst_file"; fi

  # 3. Default instance
  echo "3. Default instance"
  local def_file="$cfg_dir/default" prev="" stale=""
  prev="$(_mnemon_default_instance "$def_file" 2>/dev/null || true)"
  if [[ -n "$prev" && "$prev" != "$name" && ! -f "$inst_dir/$prev.yaml" ]]; then
    stale="$prev"; prev=""
  fi
  if $set_default || [[ -z "$prev" ]]; then
    printf '%s\n' "$name" > "$def_file"
    if [[ -n "$stale" ]]; then
      echo "  ✓ default instance → $name ($def_file; it named '$stale', which has no config at $inst_dir/$stale.yaml)"
    else
      echo "  ✓ default instance → $name ($def_file)"
    fi
    prev="$name"
  else
    echo "  ○ default instance unchanged: $prev (use --default to switch)"
  fi

  echo ""
  echo "Next: mnemon doctor"
  if [[ "$prev" != "$name" ]]; then
    echo "      (this instance is not the default — select it with: mnemon --instance $name doctor)"
  fi
}

# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

DOCTOR_JSON=false
DOCTOR_FAILS=0
DOCTOR_ITEMS=""

_check() {
  local status="$1" name="$2" detail="$3"
  if [[ "$status" == fail ]]; then DOCTOR_FAILS=$((DOCTOR_FAILS + 1)); fi
  if $DOCTOR_JSON; then
    if [[ -n "$DOCTOR_ITEMS" ]]; then DOCTOR_ITEMS="$DOCTOR_ITEMS,"; fi
    DOCTOR_ITEMS="$DOCTOR_ITEMS{\"name\":\"$(_json_str "$name")\",\"status\":\"$status\",\"detail\":\"$(_json_str "$detail")\"}"
  else
    printf '%s %s — %s\n' "$status" "$name" "$detail"
  fi
}

# Vault state dir (D6): ${XDG_STATE_HOME:-~/.local/state}/mnemon/vaults/<sha256(physical
# vault path)[:16]>. The loader's export wins when present (MNEMON_VAULT_STATE_DIR);
# otherwise the same rule, computed here exactly as bin/mnemon-ingest.py computes it.
_vault_state_dir() {
  if [[ -n "${MNEMON_VAULT_STATE_DIR:-}" ]]; then printf '%s' "${MNEMON_VAULT_STATE_DIR%/}"; return 0; fi
  python3 - "$VAULT_PATH" "$(mnemon_state_home)" <<'PY'
import hashlib, os, sys
vault = os.path.realpath(sys.argv[1].rstrip("/") or "/").rstrip("/") or "/"
print(os.path.join(sys.argv[2], "mnemon", "vaults", hashlib.sha256(vault.encode("utf-8")).hexdigest()[:16]))
PY
}

# fence — the installed Claude Code: version, --restricted, and a recorded probe
# pass for exactly that version (D13; written by `mnemon fence-probe`). Observational.
_doctor_fence() {
  local ver_line ver help_out has_restricted=false probes rec rest stamp summary tab
  if ! command -v claude >/dev/null 2>&1; then
    _check warn fence "claude not on PATH (see deps) — extraction and mnemon fence-probe need it"
    return 0
  fi
  ver_line="$(claude --version 2>/dev/null </dev/null || true)"
  ver_line="${ver_line%%$'\n'*}"
  ver="${ver_line%% *}"
  if ! [[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
    _check warn fence "claude --version printed no version token${ver_line:+ ($ver_line)}"
    return 0
  fi
  help_out="$(claude --help 2>&1 </dev/null || true)"
  case "$help_out" in *--restricted*) has_restricted=true ;; esac
  if ! $has_restricted; then
    _check fail fence "claude $ver lacks --restricted (>= 2.1.296 required)"
    return 0
  fi
  probes="$(mnemon_state_home)/mnemon/fence-probes.json"
  rec="none"
  if [[ -f "$probes" ]]; then
    rec="$(python3 - "$probes" "$ver" "$ver_line" <<'PY' 2>/dev/null || echo unreadable
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        doc = json.load(fh)
except Exception:
    print("unreadable")
    sys.exit(0)
for key in (sys.argv[2], sys.argv[3]):
    rec = doc.get(key) if isinstance(doc, dict) else None
    if isinstance(rec, dict):
        # the probed list (§12 A9): true = probed, "skipped" = documented, false = failed
        probes = rec.get("probes") if isinstance(rec.get("probes"), dict) else {}
        probed = [k for k, v in probes.items() if v is True]
        documented = [k for k, v in probes.items() if v == "skipped"]
        failed = [k for k, v in probes.items() if v is False]
        parts = []
        if probed:
            parts.append("probed: " + ", ".join(probed))
        parts += [k + ": documented" for k in documented] + [k + ": failed" for k in failed]
        print(("pass " if rec.get("pass") is True else "fail ") + str(rec.get("date") or "unknown date") + "\t" + "; ".join(parts))
        sys.exit(0)
print("none")
PY
)"
  fi
  tab=$'\t'
  rest="${rec#pass }"; rest="${rest#fail }"
  stamp="${rest%%$tab*}"; summary=""
  [[ "$rest" == *"$tab"* ]] && summary="${rest#*$tab}"
  case "$rec" in
    pass*)      _check ok fence "claude $ver, --restricted available, probed $stamp${summary:+ — $summary}" ;;
    fail*)      _check warn fence "claude $ver failed its fence probe on $stamp${summary:+ ($summary)}; run: mnemon fence-probe" ;;
    unreadable) _check warn fence "claude $ver, --restricted available, but $probes is unreadable; run: mnemon fence-probe" ;;
    *)          _check warn fence "claude $ver has no probe record; run: mnemon fence-probe" ;;
  esac
}

# vault-state — the per-vault state dir exists and is writable (or its parent is), mode 0700.
_doctor_vault_state() {
  local dir mode parent
  dir="$(_vault_state_dir)"
  if [[ -d "$dir" ]]; then
    if [[ ! -w "$dir" ]]; then
      _check warn vault-state "$dir is not writable"
      return 0
    fi
    mode="$(python3 -c 'import os, stat, sys; print("%04o" % stat.S_IMODE(os.stat(sys.argv[1]).st_mode))' "$dir" 2>/dev/null || echo '?')"
    if [[ "$mode" == 0700 ]]; then
      _check ok vault-state "$dir"
    else
      _check warn vault-state "$dir mode $mode, expected 0700"
    fi
  else
    parent="$(_nearest_existing_parent "$dir")"
    if [[ -n "$parent" && -w "$parent" ]]; then
      _check ok vault-state "$dir (absent, parent writable)"
    else
      _check warn vault-state "cannot create $dir (nearest existing parent ${parent:-/} is not writable)"
    fi
  fi
}

# vault-lock — a non-blocking flock probe of <vault state>/lock on a private descriptor that is
# closed at once (closing releases it; nothing here calls LOCK_UN); a missing lock file is never created.
_doctor_vault_lock() {
  local lockf res
  lockf="$(_vault_state_dir)/lock"
  if [[ ! -e "$lockf" ]]; then
    _check ok vault-lock "free (no $lockf yet)"
    return 0
  fi
  res="$(python3 - "$lockf" <<'PY' 2>/dev/null || echo error
import fcntl, os, sys
fd = os.open(sys.argv[1], os.O_RDWR)
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    print("held")
    sys.exit(0)
os.close(fd)
print("free")
PY
)"
  case "$res" in
    free) _check ok vault-lock "free ($lockf)" ;;
    held) _check warn vault-lock "held ($lockf) — a capture or an ingest pass is running" ;;
    *)    _check warn vault-lock "could not probe $lockf" ;;
  esac
}

# captures — receipts in <vault state>/captures/: failed / extract-failed (finish with
# --resume), and published receipts whose revision folder or source.md is gone.
# --- phase 2 (capture layer §3.10): the converter chain's tools, the egress policy, canonical identity ---

# _version_ge <have> <want>: dotted numeric comparison (non-numeric suffixes ignored). bash 3.2.
_version_ge() {
  local have="$1" want="$2" i hv wv
  local -a h w
  IFS=. read -r -a h <<<"$have"
  IFS=. read -r -a w <<<"$want"
  for ((i = 0; i < ${#w[@]}; i++)); do
    hv="${h[i]:-0}"; wv="${w[i]:-0}"
    hv="${hv%%[^0-9]*}"; wv="${wv%%[^0-9]*}"
    [[ "${hv:-0}" -gt "${wv:-0}" ]] && return 0
    [[ "${hv:-0}" -lt "${wv:-0}" ]] && return 1
  done
  return 0
}

# The Chrome/Chromium the renderer would use — the same candidate list as bin/render-url.sh.
_chrome_path() {
  local candidate
  for candidate in \
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "/Applications/Chromium.app/Contents/MacOS/Chromium" \
    "$(command -v google-chrome 2>/dev/null)" \
    "$(command -v chromium 2>/dev/null)"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then printf '%s' "$candidate"; return 0; fi
  done
  return 1
}

# capture-deps — defuddle ≥ 0.6, pandoc ≥ 3, Chrome (rendering), Poppler (PDF), with versions.
# Every one is optional at runtime (a missing converter is a skipped candidate, a missing Chrome
# means no rendered stage, a missing Poppler refuses PDFs): warn, never fail.
_doctor_capture_deps() {
  local status=ok detail="" v chrome
  if command -v defuddle >/dev/null 2>&1; then
    v="$(defuddle --version 2>/dev/null | head -1 | tr -d '[:space:]')"; v="${v#v}"
    if _version_ge "${v:-0}" 0.6; then
      detail="defuddle ${v:-?}"
    else
      status=warn; detail="defuddle ${v:-?} (< 0.6 — upgrade: npm install -g defuddle)"
    fi
  else
    status=warn; detail="defuddle missing (pandoc and the DOM text remain as converters)"
  fi
  if command -v pandoc >/dev/null 2>&1; then
    v="$(pandoc --version 2>/dev/null | head -1 | awk '{print $2}')"
    if _version_ge "${v:-0}" 3; then
      detail="$detail · pandoc ${v:-?}"
    else
      status=warn; detail="$detail · pandoc ${v:-?} (< 3 — upgrade: brew install pandoc)"
    fi
  else
    status=warn; detail="$detail · pandoc missing (html conversion falls back to the DOM text)"
  fi
  if chrome="$(_chrome_path)"; then
    v="$("$chrome" --version 2>/dev/null | head -1 | sed 's/[[:space:]]*$//')"
    detail="$detail · chrome ${v:-found} ($chrome)"
  else
    status=warn; detail="$detail · chrome missing (rendering unavailable: JavaScript shells and bot walls cannot be rendered)"
  fi
  if command -v pdftotext >/dev/null 2>&1 && command -v pdfinfo >/dev/null 2>&1; then
    v="$(pdftotext -v 2>&1 | head -1 | awk '{print $3}')"
    detail="$detail · poppler ${v:-found}"
  else
    status=warn; detail="$detail · poppler missing (PDF captures refused: brew install poppler)"
  fi
  _check "$status" capture-deps "$detail"
}

# egress — the instance's external_fetch value and, per fetcher of external_fetchers, whether its
# key variable is set. The key itself is never printed. The loader's exports win when present;
# before them the instance file is read directly; defaults: off, firecrawl,jina (spec §5).
_doctor_egress() {
  local mode fetchers f var detail="" keyed=0
  mode="${EXTERNAL_FETCH:-}"
  if [[ -z "$mode" && -n "${MNEMON_CONFIG_FILE:-}" && -f "${MNEMON_CONFIG_FILE:-}" ]]; then
    mode="$(_parse_yaml_value external_fetch "$MNEMON_CONFIG_FILE" 2>/dev/null || true)"
  fi
  mode="${mode:-off}"
  fetchers="${EXTERNAL_FETCHERS:-}"
  if [[ -z "$fetchers" && -n "${MNEMON_CONFIG_FILE:-}" && -f "${MNEMON_CONFIG_FILE:-}" ]]; then
    fetchers="$(_parse_yaml_value external_fetchers "$MNEMON_CONFIG_FILE" 2>/dev/null || true)"
  fi
  fetchers="${fetchers:-firecrawl,jina}"
  for f in $(printf '%s' "$fetchers" | tr ',' ' '); do
    case "$f" in
      firecrawl) var=FIRECRAWL_API_KEY ;;
      jina)      var=JINA_API_KEY ;;
      *)         detail="${detail:+$detail · }$f: unknown fetcher"; continue ;;
    esac
    if [[ -n "${!var:-}" ]]; then
      detail="${detail:+$detail · }$f: $var set"; keyed=$((keyed + 1))
    else
      detail="${detail:+$detail · }$f: $var not set"
    fi
  done
  case "$mode" in
    off)  _check ok egress "external_fetch off (never past the local chain); $detail" ;;
    auto) if [[ $keyed -gt 0 ]]; then
            _check ok egress "external_fetch auto (after direct and rendered fail on a bot wall, a 403 or a JavaScript shell); $detail"
          else
            _check warn egress "external_fetch auto but no fetcher has a key (external stage always skipped); $detail"
          fi ;;
    *)    _check warn egress "external_fetch '$mode' is not off|auto (the loader refuses it); $detail" ;;
  esac
}

# canonical — the identity rules this engine applies to new url captures: canonicalization v1,
# answered by capture-fetch.py --canonical-only (no network) when the capture layer is present.
_doctor_canonical() {
  local cf="$BIN_DIR/capture-fetch.py" out ver
  if [[ ! -f "$cf" ]]; then
    _check warn canonical "canonicalization v1 expected, but bin/capture-fetch.py is not present in this engine (URL captures unavailable)"
    return 0
  fi
  if out="$(python3 "$cf" --canonical-only 'https://example.com/post?utm_source=doctor' 2>/dev/null)" \
     && ver="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin)["canonical_version"])' 2>/dev/null)"; then
    if [[ "$ver" == 1 ]]; then
      _check ok canonical "canonicalization v1 (capture-fetch.py --canonical-only)"
    else
      _check warn canonical "capture-fetch.py reports canonicalization v$ver; this engine expects v1"
    fi
  else
    _check warn canonical "canonicalization v1 expected, but capture-fetch.py --canonical-only failed"
  fi
}

# captures — the ledger's receipts (failed with the --resume hint, integrity errors, missing files,
# unreadable) and, receipt-independent (§12 A2), every Sources/*/source.md whose header is not
# closed within 256 KB: malformed-frontmatter folders the lookup cannot read.
_doctor_captures() {
  local cdir out status detail tab
  cdir="$(_vault_state_dir)/captures"
  out="$(python3 - "$cdir" "$VAULT_PATH" <<'PY' 2>/dev/null || printf 'warn\tcould not scan %s' "$cdir"
import glob, json, os, sys
cdir, vault = sys.argv[1], sys.argv[2]
total = failed = missing = unreadable = integrity = 0
first_failed = None
have_ledger = os.path.isdir(cdir)
for path in (sorted(glob.glob(os.path.join(glob.escape(cdir), "*.json"))) if have_ledger else []):
    total += 1
    try:
        with open(path, encoding="utf-8") as fh:
            rec = json.load(fh)
    except Exception:
        unreadable += 1
        continue
    if not isinstance(rec, dict) or rec.get("schema") != "mnemon-capture-receipt/1":
        unreadable += 1
        continue
    state = rec.get("state")
    if state in ("failed", "extract-failed"):
        failed += 1
        if first_failed is None:
            first_failed = rec.get("capture_id") or os.path.basename(path)[:-5]
    elif state == "integrity-error":
        integrity += 1
    elif state in ("source-published", "extracted"):
        rev = rec.get("revision")
        if not isinstance(rev, str) or not rev or not os.path.isfile(os.path.join(vault, "Sources", rev, "source.md")):
            missing += 1
# §12 A2 — the whole header of every source.md, through the closing delimiter, cap 256 KB: an opening
# `---` without a closing `---`/`...` within the cap is malformed-frontmatter (never silently truncated)
CAP = 256 * 1024
malformed = []
for sm in sorted(glob.glob(os.path.join(glob.escape(vault), "Sources", "*", "source.md"))):
    folder = os.path.basename(os.path.dirname(sm))
    try:
        with open(sm, "rb") as fh:
            data = fh.read(CAP + 1)
    except OSError:
        malformed.append(folder)
        continue
    lines = data.decode("utf-8", errors="replace").split("\n")
    if not lines or lines[0].strip() != "---":
        continue
    pos = len(lines[0]) + 1
    closed = False
    for ln in lines[1:]:
        if ln.strip() in ("---", "..."):
            closed = pos <= CAP
            break
        pos += len(ln) + 1
    if not closed:
        malformed.append(folder)
parts = []
if failed:
    parts.append("%d failed/extract-failed receipt(s) — finish with: mnemon add --resume %s" % (failed, first_failed))
if integrity:
    parts.append("%d integrity-error receipt(s) — a published source.md is missing or was edited (operator: restore it, then replay)" % integrity)
if missing:
    parts.append("%d receipt(s) point at missing files" % missing)
if unreadable:
    parts.append("%d unreadable receipt(s)" % unreadable)
if malformed:
    parts.append("%d malformed-frontmatter folder(s) — source.md header without a closing --- within 256 KB, unreadable to the lookup: %s"
                 % (len(malformed), ", ".join(malformed[:5]) + (", …" if len(malformed) > 5 else "")))
if parts:
    print("warn\t" + ("none (no %s yet); " % cdir if not have_ledger else "") + "; ".join(parts))
elif not have_ledger:
    print("ok\tnone (no %s yet)" % cdir)
else:
    print("ok\t%d receipt(s), none failed" % total)
PY
)"
  tab=$'\t'
  status="${out%%$tab*}"
  detail="${out#*$tab}"
  _check "$status" captures "$detail"
}

# ingest — per known inbox: results still pending — a retryable failed, exhausted, incomplete
# or deferred — raise a warning; permanent failures (failed, retryable false: a contract
# refusal, an invalid request, an unsupported type…) are reported as `permanent N (not
# retried)` in the detail and never raise the status — they wait for a corrected envelope or
# a --retry, not for the next pass, so an inbox must not warn forever on them.
_doctor_ingest() {
  local idir out status detail tab
  idir="$(_vault_state_dir)/ingest"
  if [[ ! -d "$idir" ]]; then
    _check ok ingest "none (no $idir yet)"
    return 0
  fi
  out="$(python3 - "$idir" <<'PY' 2>/dev/null || printf 'warn\tcould not scan %s' "$idir"
import glob, json, os, sys
idir = sys.argv[1]
warn_parts = []
ok_parts = []
total = 0
for sub in sorted(os.listdir(idir)):
    rdir = os.path.join(idir, sub, "results")
    if not os.path.isdir(rdir):
        continue
    counts = {"failed": 0, "exhausted": 0, "incomplete": 0, "deferred": 0}
    permanent = 0
    for path in glob.glob(os.path.join(rdir, "*.json")):
        total += 1
        try:
            with open(path, encoding="utf-8") as fh:
                rec = json.load(fh)
        except Exception:
            continue
        state = rec.get("state") if isinstance(rec, dict) else None
        if state == "failed" and rec.get("retryable") is False:
            permanent += 1
        elif state in counts:
            counts[state] += 1
    label = sub
    try:
        with open(os.path.join(idir, sub, "inbox.json"), encoding="utf-8") as fh:
            meta = json.load(fh)
        if isinstance(meta, dict) and meta.get("inbox"):
            label = meta["inbox"]
    except Exception:
        pass
    pending = ["%s %d" % kv for kv in counts.items() if kv[1]]
    if permanent:
        pending.append("permanent %d (not retried)" % permanent)
    if not pending:
        continue
    detail = label + ": " + ", ".join(pending)
    if any(counts.values()):
        warn_parts.append(detail)
    else:
        ok_parts.append(detail)
if warn_parts:
    print("warn\t" + "; ".join(warn_parts + ok_parts))
else:
    print("ok\t%d result(s), nothing pending" % total + ("; " + "; ".join(ok_parts) if ok_parts else ""))
PY
)"
  tab=$'\t'
  status="${out%%$tab*}"
  detail="${out#*$tab}"
  _check "$status" ingest "$detail"
}

# data — the vault store checks of docs/specs/2026-10-16-vault-store.md (S3–S5): bin/vault-doctor.py
# on one read-only snapshot of the vault. Every line is routed through _check so text and JSON stay
# uniform; in --json the tool's whole mnemon-doctor-data/1 document is embedded as "data". An
# exception in the tool is one `fail doctor/data — error: …` line — the engine checks are never lost.
DOCTOR_DATA_JSON=""
_doctor_data() {
  local outf errf linesf rc=0 tab=$'\t' status name detail err
  outf="$(mktemp)"; errf="$(mktemp)"; linesf="$(mktemp)"
  if $DOCTOR_JSON; then
    python3 "$BIN_DIR/vault-doctor.py" --json >"$outf" 2>"$errf" || rc=$?
  else
    python3 "$BIN_DIR/vault-doctor.py" --tsv >"$outf" 2>"$errf" || rc=$?
  fi
  if [[ $rc -ne 0 || ! -s "$outf" ]]; then
    err="$(tail -c 400 "$errf" | tr '\n\t' '  ' | sed 's/[[:space:]]*$//')"
    _check fail doctor/data "error: ${err:-vault-doctor.py exited $rc without output}"
    rm -f "$outf" "$errf" "$linesf"
    return 0
  fi
  if $DOCTOR_JSON; then
    DOCTOR_DATA_JSON="$(cat "$outf")"
    if ! python3 - "$outf" >"$linesf" 2>"$errf" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as fh:
    doc = json.load(fh)
for c in doc["checks"]:
    print("%s\t%s\t%s" % (c["status"], c["name"], c["detail"].replace("\t", " ").replace("\n", " ")))
PY
    then
      _check fail doctor/data "error: vault-doctor.py --json printed no readable document ($(tail -c 200 "$errf" | tr '\n' ' '))"
      DOCTOR_DATA_JSON=""
      rm -f "$outf" "$errf" "$linesf"
      return 0
    fi
  else
    mv "$outf" "$linesf"
  fi
  while IFS="$tab" read -r status name detail; do
    [[ -n "$status" && -n "$name" ]] || continue
    _check "$status" "$name" "$detail"
  done <"$linesf"
  rm -f "$outf" "$errf" "$linesf"
  return 0
}

cmd_doctor() {
  local with_data=false list_check=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --instance) [[ $# -lt 2 ]] && usage_error "doctor: --instance requires a value"; _select_instance "$2"; _apply_selectors; shift 2 ;;
      --json)     DOCTOR_JSON=true; shift ;;
      --data)     with_data=true; shift ;;
      --list)     [[ $# -lt 2 ]] && usage_error "doctor: --list requires a check name (e.g. thin or data/thin)"; list_check="$2"; with_data=true; shift 2 ;;
      -h|--help)  usage; exit 0 ;;
      *)          usage_error "doctor: unknown option $1" ;;
    esac
  done
  # --list prints only that list: every item of one data check, tab-separated (read-only)
  if [[ -n "$list_check" ]]; then
    _resolve_or_die
    exec python3 "$BIN_DIR/vault-doctor.py" --list "$list_check"
  fi

  local have_config=false errf warn
  errf="$(mktemp)"
  if load_config 2>"$errf"; then
    have_config=true
    warn="$(tr '\n' ' ' <"$errf" | sed 's/[[:space:]]*$//')"
    if [[ -n "$warn" ]]; then
      _check warn config "$MNEMON_CONFIG_FILE (instance $MNEMON_INSTANCE; selected by $MNEMON_CONFIG_SOURCE); $warn"
    else
      _check ok config "$MNEMON_CONFIG_FILE (instance $MNEMON_INSTANCE; selected by $MNEMON_CONFIG_SOURCE)"
    fi
  else
    _check fail config "$(tr '\n' ' ' <"$errf" | sed 's/[[:space:]]*$//')"
  fi
  rm -f "$errf"

  if $have_config; then
    # vault
    local missing=""
    if [[ ! -d "$VAULT_PATH" ]]; then
      missing="vault directory"
    else
      [[ -d "$VAULT_PATH/Sources" ]] || missing="Sources/"
      if [[ ! -d "$VAULT_PATH/_meta" ]]; then missing="${missing:+$missing, }_meta/"; fi
    fi
    if [[ -z "$missing" ]]; then
      _check ok vault "$VAULT_PATH"
    elif [[ "$MNEMON_INSTANCE" == "$MNEMON_ADHOC_INSTANCE" ]]; then
      _check fail vault "$VAULT_PATH (missing: $missing) — fix vault_path in $MNEMON_CONFIG_FILE"
    else
      _check fail vault "$VAULT_PATH (missing: $missing) — run: mnemon init $MNEMON_INSTANCE --vault $VAULT_PATH --force"
    fi

    # reader-context
    if [[ -f "$READER_CONTEXT_PATH" ]]; then
      _check ok reader-context "$READER_CONTEXT_PATH"
    else
      _check fail reader-context "not found: $READER_CONTEXT_PATH"
    fi

    # charter
    if [[ -f "$CHARTER_PATH" ]]; then
      _check ok charter "$CHARTER_PATH"
    else
      _check warn charter "missing $CHARTER_PATH (optional)"
    fi

    # archive
    if [[ -z "$ARCHIVE_DIR" ]]; then
      _check ok archive "archive_dir not set (skipped)"
    elif [[ ! -d "$ARCHIVE_DIR" ]]; then
      _check fail archive "not a directory: $ARCHIVE_DIR"
    elif [[ ! -w "$ARCHIVE_DIR" ]]; then
      _check fail archive "not writable: $ARCHIVE_DIR"
    else
      _check ok archive "$ARCHIVE_DIR (writable)"
    fi

    # state — observational: report whether the dir exists or could be created,
    # never create it (doctor writes nothing)
    if [[ -d "$MNEMON_STATE_DIR" ]]; then
      if [[ -w "$MNEMON_STATE_DIR" ]]; then
        _check ok state "$MNEMON_STATE_DIR"
      else
        _check fail state "$MNEMON_STATE_DIR is not writable"
      fi
    else
      local parent
      parent="$(_nearest_existing_parent "$MNEMON_STATE_DIR")"
      if [[ -n "$parent" && -w "$parent" ]]; then
        _check ok state "$MNEMON_STATE_DIR (absent, parent writable)"
      else
        _check fail state "cannot create $MNEMON_STATE_DIR (nearest existing parent ${parent:-/} is not writable)"
      fi
    fi
  fi

  # deps — required
  local required="claude jq shasum python3" optional="defuddle pandoc yt-dlp ffprobe whisper"
  local dep missing_req="" missing_opt=""
  for dep in $required; do
    command -v "$dep" >/dev/null 2>&1 || missing_req="${missing_req:+$missing_req }$dep"
  done
  if [[ -z "$missing_req" ]]; then
    _check ok deps "required present: $required"
  else
    _check fail deps "missing required: $missing_req"
  fi
  for dep in $optional; do
    command -v "$dep" >/dev/null 2>&1 || missing_opt="${missing_opt:+$missing_opt }$dep"
  done
  if [[ -z "$missing_opt" ]]; then
    _check ok deps-optional "all present: $optional"
  else
    _check warn deps-optional "missing: $missing_opt"
  fi
  # python packages: pyyaml for the depth manifest (kb-depth-fold.py). `requests` is no longer
  # used — every request the engine makes goes through bin/capture/policy.py on the stdlib (D3)
  local missing_py=""
  python3 -c 'import yaml' >/dev/null 2>&1 || missing_py="pyyaml"
  if [[ -z "$missing_py" ]]; then
    _check ok deps-python "pyyaml"
  else
    _check warn deps-python "missing: $missing_py (depth-aware capture needs it; pip3 install $missing_py)"
  fi

  # phase 2 (capture layer §3.10): the converter chain's tools with versions, the egress policy,
  # the canonical identity rules
  _doctor_capture_deps
  _doctor_egress
  _doctor_canonical

  # qmd — required only when search_provider is qmd
  if $have_config && [[ "$SEARCH_PROVIDER" == qmd ]]; then
    if ! command -v qmd >/dev/null 2>&1; then
      _check fail qmd "search_provider is qmd but qmd is not installed"
    else
      _check ok qmd "$(command -v qmd)"
      # `qmd collection list` creates ${XDG_CACHE_HOME:-~/.cache}/qmd/index.sqlite on
      # a host where qmd never ran — doctor writes nothing, so the collection is
      # probed only when qmd's cache dir already exists.
      local qmd_cache listing
      qmd_cache="${XDG_CACHE_HOME:-$HOME/.cache}/qmd"
      if [[ ! -d "$qmd_cache" ]]; then
        _check warn qmd-collection "not probed (qmd never ran here: no $qmd_cache, and 'qmd collection list' would create its index) — run: qmd collection add $QMD_COLLECTION $VAULT_PATH --mode hybrid"
      elif listing="$(qmd collection list 2>/dev/null)"; then
        if printf '%s\n' "$listing" | awk -v c="$QMD_COLLECTION" '$1 == c { found = 1 } END { exit !found }'; then
          _check ok qmd-collection "$QMD_COLLECTION"
        else
          _check warn qmd-collection "collection '$QMD_COLLECTION' not in 'qmd collection list' — run: qmd collection add $QMD_COLLECTION $VAULT_PATH --mode hybrid"
        fi
      else
        _check warn qmd-collection "could not run 'qmd collection list' (skipped)"
      fi
    fi
  fi

  # engine
  local root_phys home_phys branch
  root_phys="$(_abs_dir "$MNEMON_ROOT")"
  if [[ -z "${MNEMON_HOME:-}" ]]; then
    _check warn engine "MNEMON_HOME not set (running from $root_phys)"
  else
    home_phys="$(_abs_dir "$MNEMON_HOME" 2>/dev/null || true)"
    if [[ -z "$home_phys" ]]; then
      _check warn engine "MNEMON_HOME=$MNEMON_HOME does not exist (running from $root_phys)"
    elif [[ "$home_phys" != "$root_phys" ]]; then
      _check warn engine "running from $root_phys, installed engine is $MNEMON_HOME"
    elif git -C "$home_phys" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      branch="$(git -C "$home_phys" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
      if [[ "$branch" == release ]]; then
        _check ok engine "$MNEMON_HOME (branch release)"
      else
        _check warn engine "$MNEMON_HOME is on branch $branch, expected release"
      fi
    else
      _check ok engine "$MNEMON_HOME"
    fi
  fi

  # engine-lock — is a `mnemon release` moving the engine right now? The release's
  # own smoke runs doctor with MNEMON_ENGINE_LOCK_OWNER=<its pid>: that lock is
  # expected, not a warning.
  local lockf lstate=0 lock_pid
  lockf="$(mnemon_engine_lock_file)"
  mnemon_engine_lock_state || lstate=$?
  case "$lstate" in
    0) _check ok engine-lock "none ($lockf)" ;;
    1) lock_pid="$(_mnemon_lock_field pid "$lockf")"
       if [[ -n "${MNEMON_ENGINE_LOCK_OWNER:-}" && "$MNEMON_ENGINE_LOCK_OWNER" == "$lock_pid" ]]; then
         _check ok engine-lock "held by the running release (pid $lock_pid, target $(_mnemon_lock_field target "$lockf")) — this doctor is its smoke"
       else
         _check warn engine-lock "engine update in progress since $(_mnemon_lock_field date "$lockf") (pid $lock_pid, target $(_mnemon_lock_field target "$lockf")) — other commands exit 75 until $lockf is removed"
       fi ;;
    2) _check warn engine-lock "stale lock $lockf (older than $((MNEMON_ENGINE_LOCK_MAX_AGE / 60)) min, ignored) — remove it if no release is running" ;;
  esac

  # fence — the extractor fence gate (D13): version, --restricted, probe record
  _doctor_fence

  if $have_config; then
    # writer
    if [[ -z "$WRITER_HOST" ]]; then
      _check ok writer "writer_host not set (any host may write)"
    else
      local this_host
      this_host="$(_host)"
      if [[ "$this_host" == "$WRITER_HOST" ]]; then
        _check ok writer "this host ($this_host) is the writer"
      else
        _check fail writer "this host must not write vault $VAULT_PATH (writer_host $WRITER_HOST, this host $this_host)"
      fi
    fi

    # pending-writes
    local pdir="$VAULT_PATH/_inputs/pending-writes" n=0
    if [[ -d "$pdir" ]]; then
      n=$(find "$pdir" -type f -not -name '.*' 2>/dev/null | wc -l | tr -d ' ')
    fi
    if [[ "$n" -gt 0 ]]; then
      _check warn pending-writes "$n file(s) in $pdir"
    else
      _check ok pending-writes "none"
    fi

    # the capture ledger of the physical vault (D6): state dir, lock, receipts, inbox results
    _doctor_vault_state
    _doctor_vault_lock
    _doctor_captures
    _doctor_ingest
  fi

  # the data group (--data): after the engine checks, on the resolved instance
  if $with_data; then
    if $have_config; then
      _doctor_data
    else
      _check warn doctor/data "not probed: no configuration"
    fi
  fi

  local rc=0
  if [[ $DOCTOR_FAILS -gt 0 ]]; then rc=1; fi
  if $DOCTOR_JSON; then
    if [[ -n "$DOCTOR_DATA_JSON" ]]; then
      printf '{"checks":[%s],"data":%s,"exit":%d}\n' "$DOCTOR_ITEMS" "$DOCTOR_DATA_JSON" "$rc"
    else
      printf '{"checks":[%s],"exit":%d}\n' "$DOCTOR_ITEMS" "$rc"
    fi
  fi
  exit $rc
}

# ---------------------------------------------------------------------------
# config
# ---------------------------------------------------------------------------

CONFIG_EXPORTS="MNEMON_ROOT MNEMON_CONFIG MNEMON_CONFIG_FILE MNEMON_CONFIG_SOURCE MNEMON_INSTANCE MNEMON_STATE_DIR MNEMON_VAULT_STATE_DIR VAULT_PATH READER_CONTEXT_PATH CHARTER_PATH SEARCH_PROVIDER QMD_COLLECTION DEFAULT_MODEL DEFAULT_LANGUAGE WHISPER_MODEL AUTO_DETECT_ORIGIN ARCHIVE_DIR WRITER_HOST EXTRACT_TIMEOUT EXTRACT_INLINE_MAX_BYTES EXTRACT_MAX_USD EXTERNAL_FETCH EXTERNAL_FETCHERS FETCH_USER_AGENT FETCH_TIMEOUT FETCH_CONNECT_TIMEOUT FETCH_READ_TIMEOUT FETCH_MAX_BYTES RENDER_TIMEOUT RENDER_MAX_BYTES ACQUIRE_TIMEOUT CONVERT_TIMEOUT TRANSCRIBE_TIMEOUT SITE_MAX_PAGES SITE_TIMEOUT THIN_WORDS EXTRACT_MAX_PARTS DOCTOR_THIN_WORDS DOCTOR_STUB_WORDS DOCTOR_ARXIV_WORDS DOCTOR_RATING_HI_SHARE"

cmd_config_list() {
  local dir inst_dir def f name vault marker count=0
  dir="$(mnemon_config_dir)"
  inst_dir="$dir/instances"
  def="$(_mnemon_default_instance "$dir/default" 2>/dev/null || true)"
  if [[ -d "$inst_dir" ]]; then
    for f in "$inst_dir"/*.yaml; do
      [[ -f "$f" ]] || continue
      name="$(basename "$f" .yaml)"
      vault="$(_parse_yaml_value vault_path "$f")"
      marker=" "
      if [[ "$name" == "$def" ]]; then marker="*"; fi
      printf '%s %-16s %s\n' "$marker" "$name" "$vault"
      count=$((count + 1))
    done
  fi
  if [[ -n "$def" && ! -f "$inst_dir/$def.yaml" ]]; then
    printf '! %-16s (stale default: %s names it, but %s does not exist — the next `mnemon init` takes the default over)\n' "$def" "$dir/default" "$inst_dir/$def.yaml"
  fi
  if [[ $count -eq 0 ]]; then
    printf 'no instances in %s\n  create one with: mnemon init <name> --vault <path>\n' "$inst_dir" >&2
  fi
}

cmd_config() {
  local sub="${1:-}"
  [[ -n "$sub" ]] || usage_error "config: expected get <key> | path | list | keys | dump"
  shift
  case "$sub" in
    get)
      local key="${1:-}" var=""
      [[ -n "$key" ]] || usage_error "config get: key required"
      case "$key" in
        vault_path)          var=VAULT_PATH ;;
        reader_context_path) var=READER_CONTEXT_PATH ;;
        archive_dir)         var=ARCHIVE_DIR ;;
        qmd_collection)      var=QMD_COLLECTION ;;
        search_provider)     var=SEARCH_PROVIDER ;;
        default_model)       var=DEFAULT_MODEL ;;
        default_language)    var=DEFAULT_LANGUAGE ;;
        whisper_model)       var=WHISPER_MODEL ;;
        auto_detect_origin)  var=AUTO_DETECT_ORIGIN ;;
        state_dir)           var=MNEMON_STATE_DIR ;;
        charter_path)        var=CHARTER_PATH ;;
        writer_host)         var=WRITER_HOST ;;
        instance)            var=MNEMON_INSTANCE ;;
        config_file)         var=MNEMON_CONFIG_FILE ;;
        config_source)       var=MNEMON_CONFIG_SOURCE ;;
        config_dir)          mnemon_config_dir; echo; return 0 ;;
        *) # the scalar keys of MNEMON_CONFIG_KEYS (capture layer §5), one table with bin/lib_config.py
           var="$(mnemon_config_var_of "$key" 2>/dev/null || true)"
           [[ -n "$var" ]] || { printf 'mnemon config get: unknown key %s\n' "$key" >&2; exit 2; } ;;
      esac
      _resolve_or_die
      printf '%s\n' "${!var}" ;;
    path)
      _resolve_or_die
      printf '%s\n' "$MNEMON_CONFIG_FILE" ;;
    list)
      cmd_config_list ;;
    keys)
      # the scalar keys with defaults: `key type default` per line (capture layer §5; the
      # table lives in bin/mnemon-config.sh, mirrored by bin/lib_config.py)
      mnemon_config_keys ;;
    dump)
      _resolve_or_die
      local v
      printf 'MNEMON_CONFIG_DIR=%s\n' "$(mnemon_config_dir)"
      for v in $CONFIG_EXPORTS; do
        printf '%s=%s\n' "$v" "${!v}"
      done ;;
    *) usage_error "config: unknown subcommand '$sub' (expected get | path | list | keys | dump)" ;;
  esac
}

# ---------------------------------------------------------------------------
# release — main → release → installed engine ($MNEMON_HOME)
# ---------------------------------------------------------------------------

RELEASE_LOCK=""
_release_lock_release() {
  if [[ -n "$RELEASE_LOCK" ]]; then
    rm -f "$RELEASE_LOCK"
    echo "release: lock removed ($RELEASE_LOCK)"
    RELEASE_LOCK=""
  fi
}

# Create the maintenance lock (refuse a fresh one, take over a stale one) and
# arrange for its removal on every exit path.
_release_lock_acquire() {
  local f="$1" target="$2" state=0
  mnemon_engine_lock_state || state=$?
  if [[ $state -eq 1 ]]; then
    echo "mnemon release: another engine update holds $f (pid $(_mnemon_lock_field pid "$f"), since $(_mnemon_lock_field date "$f")); retry later" >&2
    exit 75
  elif [[ $state -eq 2 ]]; then
    echo "release: taking over a stale lock $f (older than $((MNEMON_ENGINE_LOCK_MAX_AGE / 60)) min)"
  fi
  mkdir -p "$(dirname "$f")"
  printf 'pid=%s\ntimestamp=%s\ndate=%s\ntarget=%s\n' "$$" "$(date +%s)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$target" > "$f"
  RELEASE_LOCK="$f"
  export MNEMON_ENGINE_LOCK_OWNER="$$"
  trap '_release_lock_release' EXIT
  echo "release: lock $f (pid $$, target $target)"
}

# PIDs of engine processes whose command line matches the drain pattern $1
# (see _drain_pattern) — pgrep -f, same user and host only (documented
# limitation); never this process or its parent. Returns pgrep's verdict so the
# caller can tell idle from "could not look": 0 = busy (PIDs on stdout),
# 1 = idle, 2 = pgrep itself failed (exit > 1; its message on stderr). A
# failing pgrep used to read as idle and the release moved files under
# running processes.
_engine_pids() {
  local raw rc=0 pids
  raw="$(pgrep -f -- "$1" 2>&1)" || rc=$?
  case "$rc" in
    0) ;;
    1) return 1 ;;
    *) printf 'mnemon release: pgrep -f exited %s%s\n' "$rc" "${raw:+: $raw}" >&2; return 2 ;;
  esac
  pids="$(printf '%s\n' "$raw" | grep -E '^[0-9]+$' | grep -v -x -e "$$" -e "$PPID" | tr '\n' ' ' | sed 's/ *$//' || true)"
  [[ -n "$pids" ]] || return 1
  printf '%s' "$pids"
}

# Wait up to $2 seconds for engine processes under $1 (matched by the drain
# pattern $3) to finish; 1 on timeout, 2 when pgrep cannot answer.
_release_drain() {
  local home="$1" timeout="$2" pattern="$3" waited=0 pids rc
  while :; do
    rc=0
    pids="$(_engine_pids "$pattern")" || rc=$?
    if [[ $rc -eq 1 ]]; then
      echo "release: drain — no engine processes running from $home/bin/"
      return 0
    elif [[ $rc -ne 0 ]]; then
      echo "mnemon release: drain — cannot tell whether engine processes are running from $home/bin/ (pgrep failed, see above); not proceeding blind" >&2
      echo "  nothing was changed; fix pgrep (or the PATH it comes from) and retry" >&2
      return 2
    fi
    if [[ $waited -ge $timeout ]]; then
      echo "mnemon release: engine busy after ${timeout}s — still running from $home/bin/: $pids" >&2
      echo "  nothing was changed; wait for them to finish or raise --drain-timeout <s>" >&2
      return 1
    fi
    if [[ $waited -eq 0 ]]; then echo "release: drain — waiting up to ${timeout}s for engine processes to finish ($pids)"; fi
    sleep 1
    waited=$((waited + 1))
  done
}

# Smoke = engine health only: config resolves, version reports the new commit,
# tests/test_config.sh passes, doctor exits 0 — or 1 with no fail line other
# than the environmental deps/qmd/writer; any other exit (a crash, a usage
# error, a missing binary, 75) fails the smoke, whatever the output says.
# MNEMON_SMOKE_CMD replaces the checks — a test hook, honoured only together
# with MNEMON_TEST_HOOKS=1 so a stray variable in a production environment can
# never stand in for the smoke.
_release_smoke() {
  local home="$1" new_sha="$2" ok=true out log bad drc=0
  if [[ -n "${MNEMON_SMOKE_CMD:-}" ]]; then
    if [[ "${MNEMON_TEST_HOOKS:-}" == 1 ]]; then
      echo "release: smoke — MNEMON_SMOKE_CMD override (MNEMON_TEST_HOOKS=1): $MNEMON_SMOKE_CMD"
      if bash -c "$MNEMON_SMOKE_CMD"; then return 0; else return 1; fi
    fi
    echo "mnemon release: ignoring MNEMON_SMOKE_CMD — a test hook, honoured only with MNEMON_TEST_HOOKS=1; running the real smoke" >&2
  fi
  echo "release: smoke — $home/bin/mnemon config path"
  if out="$("$home/bin/mnemon" config path 2>&1)"; then echo "  $out"; else printf '%s\n' "$out" | sed 's/^/  /'; ok=false; fi
  echo "release: smoke — $home/bin/mnemon version"
  if out="$("$home/bin/mnemon" version 2>&1)"; then echo "  $out"; else printf '%s\n' "$out" | sed 's/^/  /'; ok=false; fi
  case "$out" in *"$new_sha"*) ;; *) echo "  ✗ version does not report $new_sha" >&2; ok=false ;; esac
  echo "release: smoke — bash $home/tests/test_config.sh"
  log="$(mktemp)"
  if bash "$home/tests/test_config.sh" >"$log" 2>&1; then echo "  $(tail -1 "$log")"; else cat "$log"; ok=false; fi
  rm -f "$log"
  echo "release: smoke — $home/bin/mnemon doctor (exit 0, or 1 with no fail line other than deps/qmd/writer)"
  out="$("$home/bin/mnemon" doctor 2>&1)" || drc=$?
  printf '%s\n' "$out" | sed 's/^/  /'
  case "$drc" in
    0) ;;
    1) bad="$(printf '%s\n' "$out" | grep '^fail ' | grep -v -e '^fail deps' -e '^fail qmd' -e '^fail writer' || true)"
       if [[ -n "$bad" ]]; then
         echo "  ✗ engine-health failures:" >&2
         printf '%s\n' "$bad" | sed 's/^/    /' >&2
         ok=false
       elif ! printf '%s\n' "$out" | grep -q '^fail '; then
         # doctor exits 1 only after counting a fail line; none means it died midway
         echo "  ✗ doctor exited 1 without a fail line — it did not finish its checks" >&2
         ok=false
       fi ;;
    *) echo "  ✗ doctor exited $drc (expected 0, or 1 with only deps/qmd/writer failures) — it crashed or did not run" >&2
       ok=false ;;
  esac
  $ok
}

cmd_release() {
  local dry=false now=false rollback="" drain_timeout=120
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)       dry=true; shift ;;
      --now)           now=true; shift ;;
      --rollback)      [[ $# -lt 2 ]] && usage_error "release: --rollback requires a ref"; rollback="$2"; shift 2 ;;
      --drain-timeout) [[ $# -lt 2 ]] && usage_error "release: --drain-timeout requires a number of seconds"; drain_timeout="$2"; shift 2 ;;
      -h|--help)       usage; exit 0 ;;
      *)               usage_error "release: unknown option $1" ;;
    esac
  done
  [[ "$drain_timeout" =~ ^[0-9]+$ ]] || usage_error "release: --drain-timeout must be a number of seconds"

  # --- preflight: read-only checks ---
  local home="${MNEMON_HOME:-}" home_given drain_pattern
  [[ -n "$home" ]] || die "release: MNEMON_HOME is not set (it must point at the installed engine worktree on branch release)"
  [[ -d "$home" ]] || die "release: MNEMON_HOME=$home does not exist"
  # Normalize once: `home` is the canonical physical path (no trailing slash,
  # symlinks resolved); `home_given` keeps the spelling MNEMON_HOME used, for the
  # drain pattern — "engine/" would otherwise look for "engine//bin/" and match nothing.
  home_given="$(_strip_trailing_slashes "$(_expand_tilde "$home")")"
  case "$home_given" in /*) ;; *) home_given="$PWD/$home_given" ;; esac
  home="$(_abs_dir "$home_given")" || die "release: cannot resolve MNEMON_HOME=$MNEMON_HOME"
  drain_pattern="$(_drain_pattern "$home" "$home_given")"
  git -C "$home" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "release: $home is not a git worktree"
  git -C "$MNEMON_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "release: dev tree $MNEMON_ROOT is not a git worktree"
  local home_branch
  home_branch="$(git -C "$home" rev-parse --abbrev-ref HEAD)"
  [[ "$home_branch" == release ]] || die "release: $home is on branch '$home_branch', expected 'release'"
  local dev_common home_common
  dev_common="$(_git_common_dir "$MNEMON_ROOT")" || die "release: cannot read git dir of $MNEMON_ROOT"
  home_common="$(_git_common_dir "$home")" || die "release: cannot read git dir of $home"
  [[ "$dev_common" == "$home_common" ]] || die "release: $home is not a worktree of this repo ($home_common != $dev_common)"
  if [[ "$(_abs_dir "$MNEMON_ROOT")" == "$(_abs_dir "$home")" ]]; then
    die "release: run it from the dev tree, not from the installed engine ($home) — files under a running script must not move"
  fi
  git -C "$MNEMON_ROOT" rev-parse --verify -q main >/dev/null || die "release: no 'main' branch in $MNEMON_ROOT"

  local lock prev main_sha dev_branch dev_sha dirty="clean" ancestor="yes" target_sha
  lock="$(mnemon_engine_lock_file)"
  prev="$(git -C "$home" rev-parse --short HEAD)"
  main_sha="$(git -C "$MNEMON_ROOT" rev-parse --short main)"
  dev_branch="$(git -C "$MNEMON_ROOT" rev-parse --abbrev-ref HEAD)"
  dev_sha="$(git -C "$MNEMON_ROOT" rev-parse --short HEAD)"
  if [[ -n "$(git -C "$MNEMON_ROOT" status --porcelain --untracked-files=no)" ]]; then dirty="DIRTY (uncommitted tracked changes)"; fi
  if ! git -C "$MNEMON_ROOT" merge-base --is-ancestor release main 2>/dev/null; then ancestor="NO — release has diverged from main"; fi
  if [[ -n "$rollback" ]]; then
    target_sha="$(git -C "$home" rev-parse --short --verify -q "$rollback^{commit}" 2>/dev/null)" || die "release: --rollback: unknown ref '$rollback'"
  else
    target_sha="$main_sha"
  fi
  local rollback_cmds="  mnemon release --rollback $prev
    = git -C $home reset --hard $prev
      git -C $home push --force-with-lease origin release   (only if origin/release had already moved)"

  if $dry; then
    echo "mnemon release — dry run (nothing changes)"
    echo "  dev tree:  $MNEMON_ROOT ($dev_branch @ $dev_sha, $dirty)"
    if [[ "$home" == "$home_given" ]]; then
      echo "  installed: $home (release @ $prev)"
    else
      echo "  installed: $home (release @ $prev; MNEMON_HOME=$MNEMON_HOME)"
    fi
    echo "  main:      $main_sha"
    if [[ -z "$rollback" ]]; then
      echo "  check:     git -C $MNEMON_ROOT status --porcelain --untracked-files=no   → $dirty   (before the lock)"
      echo "  check:     git -C $MNEMON_ROOT merge-base --is-ancestor release main   → $ancestor   (before the lock)"
    fi
    echo "  1. lock:   $lock (pid, timestamp, target $target_sha); removed last, also on failure"
    echo "  2. drain:  wait up to ${drain_timeout}s for processes matching: pgrep -f $drain_pattern"
    if [[ -n "$rollback" ]]; then
      echo "  3. reset:  git -C $home reset --hard $rollback   ($prev → $target_sha)"
      echo "  4. print:  git -C $home push --force-with-lease origin release   (not run)"
      echo "  5. unlock: rm $lock"
    else
      echo "  3. fetch:  git -C $MNEMON_ROOT fetch origin   (a warning when offline)"
      echo "  4. merge:  git -C $home merge --ff-only main   ($prev → $main_sha)"
      echo "  5. smoke:  $home/bin/mnemon config path · $home/bin/mnemon version (reports $main_sha) · bash $home/tests/test_config.sh · $home/bin/mnemon doctor (exit 0, or 1 with no fail other than deps/qmd/writer)"
      echo "  6. push:   git -C $home push origin release   (only after a green smoke)"
      if $now; then echo "  7. ping:   node ping not implemented (program phase 4)"; fi
      echo "  unlock:    rm $lock"
      echo "  rollback:"
      echo "$rollback_cmds"
    fi
    exit 0
  fi

  # --- refusals that need no lock: a dirty dev tree, a diverged release. Cheap
  # and read-only, so they come before the lock and the drain — otherwise the
  # lock is held for the whole drain and the refusal blames the drain, not the tree.
  if [[ -z "$rollback" ]]; then
    if [[ "$dirty" != clean ]]; then
      die "release: dev tree $MNEMON_ROOT has uncommitted tracked changes — commit or stash first (nothing was locked or changed)"
    fi
    if [[ "$ancestor" != yes ]]; then
      die "release: release has diverged from main (release=$(git -C "$MNEMON_ROOT" rev-parse --short release), main=$main_sha) — reconcile manually (nothing was locked or changed)"
    fi
  fi

  # --- 1. lock (removed by trap on every exit) · 2. drain ---
  _release_lock_acquire "$lock" "$target_sha"
  _release_drain "$home" "$drain_timeout" "$drain_pattern" || exit 1

  # --- rollback: reset under the lock, print the push ---
  if [[ -n "$rollback" ]]; then
    echo "release: rollback $home  $prev → $target_sha"
    git -C "$home" reset --hard "$rollback"
    echo "rolled back $home to $(git -C "$home" rev-parse --short HEAD); origin/release was not touched — publish the rollback by hand if it had been pushed:"
    echo "  git -C $home push --force-with-lease origin release"
    exit 0
  fi

  # --- 3. fetch (non-fatal; local branches are what the merge reads) ---
  if ! git -C "$MNEMON_ROOT" fetch origin >/dev/null 2>&1; then
    echo "mnemon release: warning — 'git fetch origin' failed (offline?); continuing with local refs" >&2
  fi
  # --- 4. ff-merge: moves the release branch and the installed worktree together ---
  echo "release: $home  $prev → $main_sha (ff-only merge of main)"
  if ! git -C "$home" merge --ff-only main; then
    die "release: ff-merge failed — roll back with: git -C $home reset --hard $prev"
  fi
  # --- 5. smoke on the updated worktree; a failure never publishes ---
  if ! _release_smoke "$home" "$main_sha"; then
    {
      echo "mnemon release: smoke failed on $home @ $main_sha. Nothing was pushed. Roll back with:"
      echo "$rollback_cmds"
    } >&2
    exit 1
  fi
  # --- 6. push: the local release stands either way, but nodes pull origin/release ---
  local new_sha
  new_sha="$(git -C "$home" rev-parse --short HEAD)"
  if ! git -C "$home" push origin release >/dev/null 2>&1; then
    {
      echo "mnemon release: released locally to $home, push failed: nodes will not see $new_sha"
      echo "  origin/release did not move (offline? no access?) — push by hand before nodes pull: git -C $home push origin release"
    } >&2
    exit 3
  fi
  if $now; then echo "node ping not implemented (program phase 4)"; fi
  echo "released $new_sha → $home"
}

# ---------------------------------------------------------------------------
# version
# ---------------------------------------------------------------------------

cmd_version() {
  local desc branch sha
  if git -C "$MNEMON_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    desc="$(git -C "$MNEMON_ROOT" describe --tags --always --dirty 2>/dev/null || echo unknown)"
    branch="$(git -C "$MNEMON_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    sha="$(git -C "$MNEMON_ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  else
    desc="unknown"
    branch="no-git"
    sha="unknown"
  fi
  printf 'mnemon %s (%s, %s) %s\n' "$desc" "$branch" "$sha" "$MNEMON_ROOT"
}

# ---------------------------------------------------------------------------
# Global options + dispatch
# ---------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
  case "$1" in
    --instance)   [[ $# -lt 2 ]] && usage_error "--instance requires a value"; _select_instance "$2"; shift 2 ;;
    --instance=*) _select_instance "${1#--instance=}"; shift ;;
    --config)     [[ $# -lt 2 ]] && usage_error "--config requires a value"; _select_config "$2"; shift 2 ;;
    --config=*)   _select_config "${1#--config=}"; shift ;;
    -h|--help)    set -- help; break ;;
    --)           shift; break ;;
    -*)           usage_error "unknown option: $1" ;;
    *)            break ;;
  esac
done
[[ $# -gt 0 ]] || usage_error "a command is required"
cmd="$1"
shift
_apply_selectors

# Engine maintenance lock (A3): everything but `release` (holds it) and `doctor`
# (reports it) exits 75 while the installed engine is being updated.
case "$cmd" in
  release|doctor) ;;
  *) mnemon_engine_lock_guard ;;
esac

case "$cmd" in
  add)      _reject_post_command_selectors "$@"; _resolve_or_die
            # The capture runs under the vault lock (D10): bin/vault-lock.py takes
            # fcntl.flock on <vault state>/lock — or proves that an inherited
            # descriptor already holds it (§12 A1) — and execs the gateway with the
            # descriptor inherited. --dry-run writes nothing and takes no lock.
            if _has_flag --dry-run "$@"; then exec "$BIN_DIR/knowledge-gateway.sh" source-add "$@"; fi
            exec python3 "$BIN_DIR/vault-lock.py" --vault "$VAULT_PATH" -- "$BIN_DIR/knowledge-gateway.sh" source-add "$@" ;;
  ingest)   _reject_post_command_selectors "$@"
            # usage (no inbox dir, --help) needs no instance; the pass does
            case "${1:-}" in ""|-h|--help) exec python3 "$BIN_DIR/mnemon-ingest.py" "$@" ;; esac
            _resolve_or_die
            exec python3 "$BIN_DIR/mnemon-ingest.py" "$@" ;;
  fence-probe)
            if [[ -f "$BIN_DIR/fence-probe.sh" ]]; then exec "$BIN_DIR/fence-probe.sh" "$@"; fi
            printf 'mnemon fence-probe: bin/fence-probe.sh not present in this engine\n' >&2
            exit 2 ;;
  status)   _reject_post_command_selectors "$@"; _resolve_or_die
            # --brief: the one line of the vault store (docs/specs/2026-10-16-vault-store.md S4) from
            # bin/vault-doctor.py — read-only, budgeted (default 10 s), honest when it cannot finish;
            # --json gives the counters and the checks' summary instead of the line
            if _has_flag --brief "$@"; then
              _status_args=()
              for _sa in "$@"; do [[ "$_sa" == --brief ]] || _status_args+=("$_sa"); done
              exec python3 "$BIN_DIR/vault-doctor.py" --brief ${_status_args[@]+"${_status_args[@]}"}
            fi
            exec "$BIN_DIR/knowledge-gateway.sh" status "$@" ;;
  site)     _reject_post_command_selectors "$@"; _resolve_or_die
            # mnemon site map <url> … → capture-site.py map (capture layer §3.6): a reviewable plan,
            # no vault write, no lock; the instance's cap, deadline and policy apply unless given
            case "${1:-}" in
              map) shift
                   site_args=(map)
                   _has_flag --max-pages "$@" || site_args+=(--max-pages "${SITE_MAX_PAGES:-40}")
                   _has_flag --site-timeout "$@" || site_args+=(--site-timeout "${SITE_TIMEOUT:-900}")
                   _has_flag --policy "$@" || site_args+=(--policy "$(jq -cn --arg ua "${FETCH_USER_AGENT:-}" --argjson ct "${FETCH_CONNECT_TIMEOUT:-15}" --argjson rt "${FETCH_READ_TIMEOUT:-45}" --argjson mb "${FETCH_MAX_BYTES:-20000000}" --argjson rmb "${RENDER_MAX_BYTES:-20000000}" --argjson tw "${THIN_WORDS:-60}" --argjson ft "${FETCH_TIMEOUT:-60}" '{user_agent:$ua, connect_timeout:$ct, read_timeout:$rt, max_bytes:$mb, max_redirects:5, fetch_timeout:$ft, render_max_bytes:$rmb, thin_words:$tw}')")
                   exec "${MNEMON_CAPTURE_SITE_CMD:-$BIN_DIR/capture-site.py}" "${site_args[@]}" "$@" ;;
              *)   usage_error "site: expected map <url> [--max-pages N] [--include <regex>]… [--exclude <regex>]… [--out <plan.json>] [--json] (a regex is searched in the page's path plus ?query; --include keeps the landing and only the matching pages)" ;;
            esac ;;
  search)   if ! _has_flag --vault "$@"; then _resolve_or_die; fi
            exec python3 "$BIN_DIR/mnemon-search.py" "$@" ;;
  reindex)  _resolve_or_die
            # index.md is written inside the vault: a writer, so it runs under the vault lock
            # (D15, §12 A1) — vault-lock.py acquires it, or proves an inherited descriptor holds it
            exec python3 "$BIN_DIR/vault-lock.py" --vault "$VAULT_PATH" -- python3 "$BIN_DIR/knowledge-reindex.py" "$VAULT_PATH" "$@" ;;
  triage)   _resolve_or_die; exec python3 "$BIN_DIR/triage-urls.py" --vault "$VAULT_PATH" "$@" ;;
  audit)    _resolve_or_die
            # --canonical (capture layer §3.10, D5): groups Sources/*/source.md by the v1 canonical form of
            # their URLs and prints the groups of ≥ 2; never writes, never merges
            if _has_flag --canonical "$@"; then
              _audit_args=()
              for _aa in "$@"; do [[ "$_aa" == --canonical ]] || _audit_args+=("$_aa"); done
              exec python3 "$BIN_DIR/canonical-audit.py" --vault "$VAULT_PATH" ${_audit_args[@]+"${_audit_args[@]}"}
            fi
            exec python3 "$BIN_DIR/archive-audit.py" --config "$MNEMON_CONFIG_FILE" "$@" ;;
  init)     cmd_init "$@" ;;
  doctor)   cmd_doctor "$@" ;;
  config)   cmd_config "$@" ;;
  release)  cmd_release "$@" ;;
  version)  cmd_version ;;
  scan|monitor)
    printf 'mnemon %s: not implemented yet (program phase 4)\n' "$cmd" >&2
    exit 2 ;;
  help|-h|--help) usage; exit 0 ;;
  *) usage_error "unknown command: $cmd" ;;
esac
